<section id="home" class="relative bg-champagne-hero overflow-hidden border-b border-sand group w-full">
  
  <div id="heroSliderTrack" class="flex w-full transition-transform duration-700 ease-in-out">
    {%- for block in section.blocks -%}
      <div class="w-full flex-shrink-0 relative min-h-[440px] sm:min-h-[500px] lg:min-h-[580px] flex items-center">
        <!-- Background Photo -->
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.heading_line_1 | escape }}" class="absolute inset-0 w-full h-full object-cover object-center">
        {%- else -%}
          <img src="{{ 'hero-banner-bg.jpg' | asset_url }}" alt="Abella Hero Banner" class="absolute inset-0 w-full h-full object-cover object-center">
        {%- endif -%}

        <!-- Content Overlay Container -->
        <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 py-10 sm:py-14 flex items-center justify-start">
          
          <!-- Left Text Content -->
          <div class="max-w-lg space-y-5 text-left bg-ivory/40 sm:bg-transparent p-4 sm:p-0 rounded-lg backdrop-blur-xs sm:backdrop-blur-none">
            <div class="space-y-1">
              <span class="text-[11px] sm:text-xs font-sans uppercase tracking-[0.25em] text-[#555340] font-medium block">{{ block.settings.sub_heading_1 }}</span>
              <span class="text-[11px] sm:text-xs font-sans uppercase tracking-[0.2em] text-[#696652] block">{{ block.settings.sub_heading_2 }}</span>
            </div>

            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-[1.08] text-[#222220]">
              {{ block.settings.heading_line_1 }}<br><span class="italic font-light">{{ block.settings.heading_line_2 }}</span>
            </h1>

            <p class="text-xs sm:text-sm text-[#555340] font-sans tracking-wider uppercase">
              {{ block.settings.description }}
            </p>

            <div class="pt-2">
              <a href="{{ block.settings.button_link | default: '#featured' }}" class="inline-flex items-center gap-3 px-7 py-3.5 bg-[#4A4C3A] text-ivory text-xs font-medium uppercase tracking-widest hover:bg-[#2E3025] transition-all duration-300 shadow-sm">
                {{ block.settings.button_text }} &rarr;
              </a>
            </div>
          </div>

        </div>
      </div>
    {%- endfor -%}
  </div>

  <!-- Carousel Arrow Buttons -->
  <button id="heroPrevBtn" aria-label="Previous Slide" class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-ivory/90 hover:bg-white text-charcoal border border-sand/60 shadow-md flex items-center justify-center transition-all duration-300 hover:scale-110">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
  </button>
  
  <button id="heroNextBtn" aria-label="Next Slide" class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-ivory/90 hover:bg-white text-charcoal border border-sand/60 shadow-md flex items-center justify-center transition-all duration-300 hover:scale-110">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
  </button>

  <!-- Carousel Dot Indicators -->
  <div id="heroDotContainer" class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center space-x-2">
    {%- for block in section.blocks -%}
      <button class="hero-dot w-2.5 h-2.5 rounded-full {% if forloop.first %}bg-olive{% else %}bg-taupe/30 hover:bg-taupe/60{% endif %} transition-all duration-300" data-slide="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
    {%- endfor -%}
  </div>

</section>

{% schema %}
{
  "name": "Hero Banner Carousel",
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "settings": [
        { "type": "text", "id": "sub_heading_1", "label": "Sub Heading 1", "default": "TWO GENERATIONS" },
        { "type": "text", "id": "sub_heading_2", "label": "Sub Heading 2", "default": "ONE BEAUTIFUL STORY" },
        { "type": "text", "id": "heading_line_1", "label": "Heading Line 1", "default": "For Every" },
        { "type": "text", "id": "heading_line_2", "label": "Heading Line 2 (Italic)", "default": "Chapter" },
        { "type": "text", "id": "description", "label": "Description", "default": "Kids Boutique | Women's Collection" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "EXPLORE OUR COLLECTION" },
        { "type": "url", "id": "button_link", "label": "Button Link", "default": "/collections/all" },
        { "type": "text", "id": "vert_1", "label": "Vertical Text 1", "default": "TIMELESS" },
        { "type": "text", "id": "vert_2", "label": "Vertical Text 2", "default": "ELEGANT" },
        { "type": "text", "id": "vert_3", "label": "Vertical Text 3", "default": "YOU" },
        { "type": "image_picker", "id": "image", "label": "Slide Background Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide", "settings": { "heading_line_1": "Little", "heading_line_2": "Dreams", "button_text": "EXPLORE KIDS BOUTIQUE", "vert_1": "CHARMING", "vert_2": "PLAYFUL", "vert_3": "JOY" } },
        { "type": "slide", "settings": { "heading_line_1": "Grace In", "heading_line_2": "Detail", "button_text": "EXPLORE WOMEN'S COLLECTION", "vert_1": "LUXURY", "vert_2": "GRACE", "vert_3": "HERITAGE" } }
      ]
    }
  ]
}
{% endschema %}
