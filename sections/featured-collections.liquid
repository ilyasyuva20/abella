<section id="featured" class="py-14 sm:py-16 bg-[#F5EFE8] border-b border-[#DFCDC0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Heading with Flanking Horizontal Lines -->
    <div class="flex items-center justify-center mb-10">
      <div class="w-16 sm:w-28 md:w-40 h-[1px] bg-[#DFCDC0]"></div>
      <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-[#2C221E] font-normal px-4 sm:px-8 text-center tracking-tight">
        {{ section.settings.heading | default: "Featured Collections" }}
      </h2>
      <div class="w-16 sm:w-28 md:w-40 h-[1px] bg-[#DFCDC0]"></div>
    </div>

    {%- comment -%}
      Live products: the chosen collection, else a "featured" collection, else
      Kids Boutique and Women's Collection alternated, else the newest products.
    {%- endcomment -%}
    {%- liquid
      assign featured_source = section.settings.collection
      if featured_source == blank and collections['featured'].products_count > 0
        assign featured_source = collections['featured']
      endif
      assign kids_products = collections['kids-boutique'].products
      assign women_products = collections['womens-collection'].products
      if featured_source == blank
        if kids_products.size == 0 or women_products.size == 0
          assign featured_source = collections['all']
        endif
      endif
      assign view_all_url = featured_source.url | default: routes.all_products_collection_url
    -%}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 lg:gap-5">
      {%- if featured_source != blank -%}
        {%- for product in featured_source.products limit: 6 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (0..5) -%}
          {%- if kids_products[i] -%}{% render 'product-card', product: kids_products[i] %}{%- endif -%}
          {%- if women_products[i] -%}{% render 'product-card', product: women_products[i] %}{%- endif -%}
          {%- assign shown = i | plus: 1 | times: 2 -%}
          {%- if shown >= 6 -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="mt-10 text-center">
      <a href="{{ view_all_url }}" class="inline-flex items-center gap-2.5 px-6 py-3 bg-[#2C221E] text-[#F5EFE8] text-[11px] font-medium uppercase tracking-[0.2em] hover:bg-[#4A3B32] transition-all duration-300 shadow-xs">
        View All &rarr;
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Collections" },
    { "type": "collection", "id": "collection", "label": "Shopify Collection" }
  ],
  "presets": [{ "name": "Featured Collections" }]
}
{% endschema %}
