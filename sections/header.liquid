<header class="sticky top-0 z-50 bg-[#FAF7F2] border-b border-[#E5DFD5] shadow-sm transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Mobile Menu Button -->
    <button id="mobileMenuBtn" aria-label="Toggle Menu" class="lg:hidden p-2 text-charcoal hover:text-olive">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="brand-logo flex items-center gap-2">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 250 }}" alt="{{ shop.name }}" class="h-12 w-auto object-contain">
      {%- else -%}
        <span class="font-serif text-2xl tracking-widest text-charcoal uppercase">ABELLA</span>
      {%- endif -%}
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center space-x-8 text-sm font-medium tracking-wider uppercase text-charcoal/90">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="nav-link hover:text-olive transition-colors py-2 border-b-2 border-transparent">{{ link.title }}</a>
      {%- else -%}
        <a href="#home" class="nav-link hover:text-olive transition-colors py-2 border-b-2 border-transparent">Home</a>
        <a href="#kids" class="nav-link hover:text-olive transition-colors py-2 border-b-2 border-transparent">Kids Boutique</a>
        <a href="#women" class="nav-link hover:text-olive transition-colors py-2 border-b-2 border-transparent">Women's Collection</a>
        <a href="#custom" class="nav-link hover:text-olive transition-colors py-2 border-b-2 border-transparent">Custom Orders</a>
        <a href="#about" class="nav-link hover:text-olive transition-colors py-2 border-b-2 border-transparent">About</a>
        <a href="#contact" class="nav-link hover:text-olive transition-colors py-2 border-b-2 border-transparent">Contact</a>
      {%- endfor -%}
    </nav>

    <!-- Icons -->
    <div class="flex items-center space-x-5 text-charcoal">
      <a href="{{ routes.search_url }}" class="p-2 hover:text-olive transition-colors" aria-label="Search">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      </a>

      <a href="{{ routes.account_url }}" class="hidden sm:block p-2 hover:text-olive transition-colors" aria-label="Account">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
      </a>

      <a href="{{ routes.cart_url }}" class="relative p-2 hover:text-olive transition-colors" aria-label="Shopping Bag">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
        <span class="absolute -top-1 -right-1 bg-olive text-ivory text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
