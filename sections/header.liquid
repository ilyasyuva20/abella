<header class="sticky top-0 z-50 bg-[#F5EFE8] border-b border-[#DFCDC0] shadow-xs transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between">
    
    <!-- Mobile Menu Button -->
    <button id="mobileMenuBtn" aria-label="Toggle Menu" class="lg:hidden p-2 text-[#2C221E] hover:text-[#7A6B60]">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <!-- Logo (Prominent & Clear) -->
    <a href="{{ routes.root_url }}" class="brand-logo flex items-center gap-2 py-1">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 600 }}" alt="{{ shop.name }}" class="h-16 sm:h-20 w-auto object-contain transition-transform duration-300 hover:scale-105 filter drop-shadow-xs mix-blend-multiply" style="mix-blend-mode: multiply;">
      {%- else -%}
        <img src="{{ 'logo.png' | asset_url }}" alt="Abella by Sebastians" class="h-16 sm:h-20 w-auto object-contain transition-transform duration-300 hover:scale-105 filter drop-shadow-xs mix-blend-multiply" style="mix-blend-mode: multiply;">
      {%- endif -%}
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center space-x-7 text-xs font-semibold tracking-[0.18em] uppercase text-[#2C221E]">
      {%- if linklists[section.settings.menu].links.size > 0 and section.settings.menu != 'main-menu' -%}
        {%- for link in linklists[section.settings.menu].links -%}
          <a href="{{ link.url }}" class="nav-link hover:text-[#7A6B60] transition-colors py-2 border-b-2 border-transparent hover:border-[#2C221E]">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#home" class="nav-link hover:text-[#7A6B60] transition-colors py-2 border-b-2 border-[#2C221E] text-[#2C221E] font-bold">HOME</a>
        <a href="#kids" class="nav-link hover:text-[#7A6B60] transition-colors py-2 border-b-2 border-transparent hover:border-[#2C221E]">KIDS BOUTIQUE</a>
        <a href="#women" class="nav-link hover:text-[#7A6B60] transition-colors py-2 border-b-2 border-transparent hover:border-[#2C221E]">WOMEN'S COLLECTION</a>
        <a href="#custom" class="nav-link hover:text-[#7A6B60] transition-colors py-2 border-b-2 border-transparent hover:border-[#2C221E]">CUSTOM ORDERS</a>
        <a href="#about" class="nav-link hover:text-[#7A6B60] transition-colors py-2 border-b-2 border-transparent hover:border-[#2C221E]">ABOUT</a>
        <a href="#contact" class="nav-link hover:text-[#7A6B60] transition-colors py-2 border-b-2 border-transparent hover:border-[#2C221E]">CONTACT</a>
      {%- endif -%}
    </nav>

    <!-- Icons (Search, Account, Wishlist, Cart) -->
    <div class="flex items-center space-x-4 text-[#2C221E]">
      <a href="{{ routes.search_url }}" class="p-1.5 hover:text-[#7A6B60] transition-colors" aria-label="Search">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      </a>

      <a href="{{ routes.account_url }}" class="hidden sm:block p-1.5 hover:text-[#7A6B60] transition-colors" aria-label="Account">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
      </a>

      <!-- Wishlist Heart Icon -->
      <a href="#wishlist" class="relative p-1.5 hover:text-[#7A6B60] transition-colors" aria-label="Wishlist">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
        <span class="absolute -top-1 -right-1 bg-[#2C221E] text-[#F5EFE8] text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-bold">0</span>
      </a>

      <!-- Cart Bag Icon -->
      <a href="{{ routes.cart_url }}" class="relative p-1.5 hover:text-[#7A6B60] transition-colors" aria-label="Shopping Bag">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
        <span class="absolute -top-1 -right-1 bg-[#2C221E] text-[#F5EFE8] text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-bold">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
