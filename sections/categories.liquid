<section class="py-14 sm:py-16 bg-[#F5EFE8] border-b border-[#DFCDC0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Heading with Flanking Horizontal Lines -->
    <div class="flex items-center justify-center mb-8">
      <div class="w-16 sm:w-28 md:w-40 h-[1px] bg-[#DFCDC0]"></div>
      <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-[#2C221E] font-normal px-4 sm:px-8 text-center tracking-tight">
        {{ section.settings.heading | default: "Shop by Category" }}
      </h2>
      <div class="w-16 sm:w-28 md:w-40 h-[1px] bg-[#DFCDC0]"></div>
    </div>

    <!-- Sub Group Divider Row (Desktop) -->
    <div class="hidden sm:grid grid-cols-5 gap-4 lg:gap-6 mb-10 items-center">
      <div class="col-span-2 flex items-center justify-center">
        <div class="flex-1 h-[1px] bg-[#DFCDC0]"></div>
        <a href="{{ collections['kids-boutique'].url | default: routes.all_products_collection_url }}" class="px-3 lg:px-4 text-[11px] lg:text-[12px] font-sans font-semibold uppercase tracking-[0.22em] text-[#7A6B60] whitespace-nowrap hover:text-[#2C221E] transition-colors">
          KIDS BOUTIQUE
        </a>
        <div class="flex-1 h-[1px] bg-[#DFCDC0]"></div>
      </div>
      <div class="col-span-3 flex items-center justify-center">
        <div class="flex-1 h-[1px] bg-[#DFCDC0]"></div>
        <a href="{{ collections['womens-collection'].url | default: routes.all_products_collection_url }}" class="px-3 lg:px-4 text-[11px] lg:text-[12px] font-sans font-semibold uppercase tracking-[0.22em] text-[#7A6B60] whitespace-nowrap hover:text-[#2C221E] transition-colors">
          WOMEN'S COLLECTION
        </a>
        <div class="flex-1 h-[1px] bg-[#DFCDC0]"></div>
      </div>
    </div>

    <!-- Mobile Sub Group Dividers (Clean & Spacious) -->
    <div class="sm:hidden flex flex-wrap justify-center gap-3 mb-6 text-[10px] font-sans font-semibold uppercase tracking-[0.18em] text-[#7A6B60]">
      <a href="{{ collections['kids-boutique'].url | default: routes.all_products_collection_url }}" class="px-3 py-1 bg-[#EADCD0] rounded-full border border-[#DFCDC0]">KIDS BOUTIQUE (2)</a>
      <a href="{{ collections['womens-collection'].url | default: routes.all_products_collection_url }}" class="px-3 py-1 bg-[#EADCD0] rounded-full border border-[#DFCDC0]">WOMEN'S COLLECTION (3)</a>
    </div>

    <!-- FLEUR Top-Arched Category Cards: 2 Kids Boutique + 3 Women's Collection -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 sm:gap-4 lg:gap-5 items-stretch">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {% render 'category-card', title: block.settings.title, image: block.settings.image, link: block.settings.link, index: forloop.index0, attributes: block.shopify_attributes %}
        {%- endfor -%}
      {%- else -%}
        {%- assign default_titles = 'Readily Available,Custom Outfits,Sarees,Blouses,Semi Partywear' | split: ',' -%}
        {%- for cat_title in default_titles -%}
          {% render 'category-card', title: cat_title, index: forloop.index0 %}
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        { "type": "category", "settings": { "title": "Custom Outfits" } },
        { "type": "category", "settings": { "title": "Readily Available" } },
        { "type": "category", "settings": { "title": "Sarees" } },
        { "type": "category", "settings": { "title": "Blouses" } },
        { "type": "category", "settings": { "title": "Semi Partywear" } }
      ]
    }
  ]
}
{% endschema %}
