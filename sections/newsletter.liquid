<section class="py-14 sm:py-16 bg-[#FAF6EE] border-b border-[#EBE3D5] relative overflow-hidden">
  <!-- Right Side Delicate Botanical Branch Line SVG Accent -->
  <div class="absolute right-4 sm:right-12 lg:right-24 top-1/2 -translate-y-1/2 opacity-35 sm:opacity-45 pointer-events-none z-0">
    <svg class="w-32 h-32 sm:w-44 sm:h-44 lg:w-56 lg:h-56 text-[#A39882]" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 110 Q50 85 105 25" />
      <path d="M45 80 Q32 65 25 55 M45 80 Q55 62 65 52" />
      <path d="M45 80 Q35 70 25 55 Q40 60 45 80" />
      <path d="M45 80 Q55 65 65 52 Q52 70 45 80" />
      <path d="M70 58 Q60 40 55 28 M70 58 Q82 42 90 32" />
      <path d="M70 58 Q60 46 55 28 Q68 40 70 58" />
      <path d="M70 58 Q82 44 90 32 Q78 48 70 58" />
      <path d="M92 36 Q85 20 80 12 M92 36 Q100 22 105 15" />
      <path d="M92 36 Q85 24 80 12 Q90 22 92 36" />
      <path d="M92 36 Q100 25 105 15 Q96 26 92 36" />
    </svg>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-3 sm:space-y-4 relative z-10">
    <!-- Serif Heading -->
    <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#1A1A1A] font-normal tracking-tight">
      {{ section.settings.heading }}
    </h2>

    <!-- Subtitle -->
    <p class="text-xs sm:text-sm text-[#555345] font-sans font-medium tracking-wide">
      {{ section.settings.description }}
    </p>

    <!-- Unified Form Bar with Border & Olive Button -->
    {% form 'customer', class: 'pt-3 max-w-xl mx-auto flex items-center justify-center' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="flex w-full items-stretch border border-[#D0C8B8] shadow-2xs overflow-hidden">
        <input type="email" 
               name="contact[email]" 
               required 
               placeholder="Enter your email address" 
               class="w-full px-4 sm:px-5 py-3 sm:py-3.5 bg-[#FAF7F2] text-xs sm:text-sm text-[#222222] font-sans focus:outline-none placeholder:text-[#A09888] placeholder:font-normal">
        <button type="submit" 
                class="flex-shrink-0 px-6 sm:px-9 py-3 sm:py-3.5 bg-[#4A4D3B] hover:bg-[#383A2C] text-white text-xs sm:text-[13px] font-sans font-medium tracking-wider uppercase transition-colors duration-300 flex items-center gap-2">
          <span>SUBSCRIBE</span>
          <span class="text-sm font-light leading-none">&rarr;</span>
        </button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Abella Family" },
    { "type": "text", "id": "description", "label": "Description", "default": "Get updates on new collections, custom designs and special offers." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
