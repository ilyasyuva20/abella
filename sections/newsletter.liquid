<section class="py-16 sm:py-20 bg-[#F5EFE8] border-b border-[#DFCDC0]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
    
    <!-- Botanical Accent Line Icon -->
    <div class="flex justify-center text-[#7A6B60]">
      <svg class="w-10 h-10 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M12 21a9 9 0 009-9c0-4.97-4.03-9-9-9s-9 4.03-9 9a9 9 0 009 9zm0 0v-9m0 0l-3.5-3.5M12 12l3.5-3.5"/></svg>
    </div>

    <div class="space-y-2">
      <h2 class="font-serif text-3xl sm:text-4xl text-[#2C221E] font-normal leading-snug">
        {{ section.settings.heading | default: "Join the Abella Story" }}
      </h2>
      <p class="text-xs sm:text-sm text-[#7A6B60] max-w-md mx-auto leading-relaxed">
        {{ section.settings.subheading | default: "Subscribe to receive updates on new boutique arrivals, festive collections, and custom tailoring previews." }}
      </p>
    </div>

    {% form 'customer', class: 'max-w-md mx-auto flex flex-col sm:flex-row gap-3 pt-2' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="Enter your email address" class="flex-1 px-5 py-3.5 bg-[#FAF6F0] border border-[#DFCDC0] text-xs text-[#2C221E] focus:outline-none focus:border-[#2C221E] rounded-none shadow-xs placeholder-[#7A6B60]/60">
      <button type="submit" class="px-8 py-3.5 bg-[#2C221E] text-[#F5EFE8] text-xs font-medium uppercase tracking-[0.2em] hover:bg-[#4A3B32] transition-colors rounded-none whitespace-nowrap shadow-xs">
        Subscribe
      </button>
    {% endform %}

  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Abella Story" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Subscribe to receive updates on new boutique arrivals, festive collections, and custom tailoring previews." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
