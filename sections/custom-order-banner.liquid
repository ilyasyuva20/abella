<section id="custom" class="py-16 sm:py-20 bg-[#F5EFE8] border-b border-[#DFCDC0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- FLEUR Signature Large Centered Architectural Arch Frame -->
    <div class="relative bg-[#EADCD0] rounded-t-[100px] sm:rounded-t-[220px] rounded-b-2xl border border-[#DFCDC0] max-w-4xl mx-auto p-6 sm:p-16 text-center space-y-5 sm:space-y-6 shadow-sm overflow-hidden">
      
      <!-- Decorative Background Macro Texture Overlay -->
      <div class="absolute inset-0 z-0 opacity-15 pointer-events-none">
        {%- if section.settings.bg_image != blank -%}
          <img src="{{ section.settings.bg_image | image_url: width: 1400 }}" alt="Custom Orders Texture" class="w-full h-full object-cover">
        {%- else -%}
          <img src="{{ 'custom-orders-bg.jpg' | asset_url }}" alt="Custom Orders Texture" class="w-full h-full object-cover">
        {%- endif -%}
      </div>

      <div class="relative z-10 space-y-4">
        <span class="text-[11px] font-sans tracking-[0.3em] uppercase text-[#7A6B60] font-semibold block">
          {{ section.settings.tag | default: "CUSTOM ORDERS & TAILORING" }}
        </span>
        
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#2C221E] font-normal leading-tight max-w-xl mx-auto">
          {{ section.settings.heading | default: "Your Ideas, Our Craftsmanship" }}
        </h2>

        <p class="text-xs sm:text-sm text-[#7A6B60] max-w-md mx-auto leading-relaxed">
          {{ section.settings.description | default: "DM or WhatsApp for personalized outfit designs, birthday dresses, and custom sizing." }}
        </p>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="{{ section.settings.whatsapp_link | default: 'https://wa.me/919446861646' }}" target="_blank" class="inline-flex items-center gap-3 px-8 py-3.5 bg-[#2C221E] text-[#F5EFE8] text-xs font-medium uppercase tracking-[0.2em] hover:bg-[#4A3B32] transition-all duration-300 shadow-sm">
            {{ section.settings.btn_text | default: "CHAT ON WHATSAPP" }} &rarr;
          </a>
          <a href="{{ section.settings.instagram_link | default: 'https://ig.me/m/abella_by_sebastians' }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-8 py-3.5 border border-[#2C221E] text-[#2C221E] text-xs font-medium uppercase tracking-[0.2em] hover:bg-[#2C221E] hover:text-[#F5EFE8] transition-all duration-300">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            {{ section.settings.instagram_btn_text | default: "CHAT ON INSTAGRAM" }} &rarr;
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Custom Orders Banner",
  "settings": [
    { "type": "text", "id": "tag", "label": "Tagline", "default": "CUSTOM ORDERS & TAILORING" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Ideas, Our Craftsmanship" },
    { "type": "text", "id": "description", "label": "Description", "default": "DM or WhatsApp for personalized outfit designs, birthday dresses, and custom sizing." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "CHAT ON WHATSAPP" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp Link" },
    { "type": "text", "id": "instagram_btn_text", "label": "Instagram Button Text", "default": "CHAT ON INSTAGRAM" },
    { "type": "url", "id": "instagram_link", "label": "Instagram Chat Link" },
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" }
  ],
  "presets": [{ "name": "Custom Orders Banner" }]
}
{% endschema %}
