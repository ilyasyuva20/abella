<footer class="bg-[#E5D5C6] text-[#2C221E] pt-14 pb-8 border-t border-[#DFCDC0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12 mb-12">
      
      <!-- Column 1: Brand Info -->
      <div class="space-y-4">
        <a href="{{ routes.root_url }}" class="brand-logo inline-block mb-2">
          {%- if section.settings.footer_logo != blank -%}
            <img src="{{ section.settings.footer_logo | image_url: width: 600 }}" alt="{{ shop.name }}" class="h-24 sm:h-28 lg:h-32 w-auto max-w-[260px] object-contain mix-blend-multiply" style="mix-blend-mode: multiply;">
          {%- else -%}
            <img src="{{ 'logo.png' | asset_url }}" alt="Abella by Sebastians" class="h-24 sm:h-28 lg:h-32 w-auto max-w-[260px] object-contain mix-blend-multiply" style="mix-blend-mode: multiply;">
          {%- endif -%}
        </a>
        <p class="text-xs text-[#7A6B60] leading-relaxed">
          {{ section.settings.about_text | default: "Handcrafted kids boutique wear and elegant women's collections. Two generations of passion and design." }}
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="space-y-3">
        <h3 class="font-serif text-base font-medium text-[#2C221E] uppercase tracking-wider">Quick Links</h3>
        <ul class="space-y-2 text-xs text-[#7A6B60]">
          <li><a href="#home" class="hover:text-[#2C221E] transition-colors">Home</a></li>
          <li><a href="#kids" class="hover:text-[#2C221E] transition-colors">Kids Boutique</a></li>
          <li><a href="#women" class="hover:text-[#2C221E] transition-colors">Women's Collection</a></li>
          <li><a href="#custom" class="hover:text-[#2C221E] transition-colors">Custom Orders</a></li>
          <li><a href="{{ routes.search_url }}" class="hover:text-[#2C221E] transition-colors">Search</a></li>
        </ul>
      </div>

      <!-- Column 3: Customer Care -->
      <div class="space-y-3">
        <h3 class="font-serif text-base font-medium text-[#2C221E] uppercase tracking-wider">Customer Care</h3>
        <ul class="space-y-2 text-xs text-[#7A6B60]">
          <li><a href="/pages/shipping-policy" class="hover:text-[#2C221E] transition-colors">Shipping & Delivery</a></li>
          <li><a href="/pages/refund-policy" class="hover:text-[#2C221E] transition-colors">Returns & Exchanges</a></li>
          <li><a href="/pages/terms-of-service" class="hover:text-[#2C221E] transition-colors">Terms of Service</a></li>
          <li><a href="/pages/privacy-policy" class="hover:text-[#2C221E] transition-colors">Privacy Policy</a></li>
          <li><a href="/pages/contact" class="hover:text-[#2C221E] transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Social -->
      <div class="space-y-3">
        <h3 class="font-serif text-base font-medium text-[#2C221E] uppercase tracking-wider">Connect With Us</h3>
        <div class="space-y-2 text-xs text-[#7A6B60]">
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.826-1.47-5.11-3.754-6.58-6.58l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
            <span>+91 94468 61646 / 80891 53124</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            <span>contact@abella.co.in</span>
          </p>
        </div>

        <div class="pt-2 flex items-center space-x-3 text-[#2C221E]">
          <a href="https://instagram.com/abella_by_sebastians" target="_blank" aria-label="Instagram" class="w-8 h-8 rounded-full bg-[#F5EFE8] border border-[#DFCDC0] flex items-center justify-center hover:bg-[#2C221E] hover:text-[#F5EFE8] transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="border-t border-[#DFCDC0] pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-[#7A6B60] space-y-2 sm:space-y-0">
      <p>&copy; {{ 'now' | date: '%Y' }} Abella by Sebastians. All Rights Reserved.</p>
      <p class="text-[11px]">Crafted with love for Kids & Women</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "footer_logo", "label": "Footer Logo" },
    { "type": "text", "id": "about_text", "label": "About Text", "default": "Handcrafted kids boutique wear and elegant women's collections. Two generations of passion and design." }
  ]
}
{% endschema %}
