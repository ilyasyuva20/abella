<div class="product-card group relative flex flex-col justify-between bg-ivory border border-sand p-3 text-center">
  <!-- Wishlist Button -->
  <button aria-label="Add to wishlist" class="absolute top-4 right-4 z-10 p-1.5 rounded-full bg-ivory/80 text-charcoal hover:text-olive transition-colors border border-sand/40">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
  </button>

  <!-- Product Image -->
  <a href="{{ product.url }}" class="product-image-wrap aspect-[4/5] overflow-hidden mb-3 border border-sand/40 bg-champagne-light block">
    {%- if product.featured_image != blank -%}
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="w-full h-full object-cover">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
    {%- endif -%}
  </a>

  <!-- Details -->
  <div class="space-y-1 text-left flex-1 flex flex-col justify-between">
    <div>
      <span class="text-[10px] uppercase font-sans tracking-widest text-taupe block">{{ product.type | default: 'Boutique Collection' }}</span>
      <h3 class="font-sans text-xs font-medium text-charcoal hover:text-olive transition-colors line-clamp-1">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
    </div>
    <div class="flex items-center justify-between pt-2 border-t border-sand/40">
      <span class="text-xs font-semibold text-charcoal">{{ product.price | money }}</span>
      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        <button type="submit" class="px-2.5 py-1 bg-olive text-ivory text-[10px] uppercase tracking-wider hover:bg-taupe transition-colors">
          + Add
        </button>
      </form>
    </div>
  </div>
</div>
