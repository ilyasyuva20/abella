{%- liquid
  assign second_image = product.images[1]
  assign age_option = product.options_by_name['Age']
  assign now = 'now' | date: '%s' | plus: 0
  assign created = product.created_at | date: '%s' | plus: 0
  assign age_seconds = now | minus: created
  assign is_new = false
  if age_seconds < 2592000
    assign is_new = true
  endif
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
    assign sale_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif
  assign review_count = product.metafields.reviews.rating_count.value | default: 0
-%}
<div class="product-card group relative flex flex-col justify-between bg-ivory border border-sand p-3 text-center">
  <!-- Wishlist (saved in this browser; see snippets/wishlist.liquid) -->
  <button type="button" aria-label="Save to wishlist" aria-pressed="false"
          data-wishlist-toggle="{{ product.handle }}"
          data-title="{{ product.title | escape }}"
          data-url="{{ product.url }}"
          data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 300 }}{% endif %}"
          data-price="{% if product.price_varies %}From {% endif %}{{ product.price | money | strip_html }}"
          class="absolute top-4 right-4 z-10 p-1.5 rounded-full bg-ivory/80 text-charcoal hover:text-[#C0504D] aria-pressed:text-[#C0504D] transition-colors border border-sand/40">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
  </button>

  <!-- Product Image (second photo shows on hover) -->
  <a href="{{ product.url }}" class="product-image-wrap abella-frame relative aspect-[4/5] overflow-hidden mb-3 border border-sand/40 bg-champagne-light block">
    {%- if product.featured_image != blank -%}
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" class="w-full h-full object-cover">
      {%- if second_image -%}
        <img src="{{ second_image | image_url: width: 600 }}" alt="" aria-hidden="true" loading="lazy" class="hidden md:block absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-500">
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
    {%- endif -%}

    <!-- Badges -->
    <span class="absolute top-3 left-3 flex flex-col items-start gap-1 text-[9px] font-sans font-semibold uppercase tracking-widest">
      {%- if product.available == false -%}
        <span class="bg-[#7A6B60] text-ivory px-2 py-0.5">Sold out</span>
      {%- else -%}
        {%- if on_sale -%}<span class="bg-[#C0504D] text-white px-2 py-0.5">Sale -{{ sale_percent }}%</span>{%- endif -%}
        {%- if product.tags contains 'Bestseller' -%}<span class="bg-charcoal text-ivory px-2 py-0.5">Bestseller</span>{%- endif -%}
        {%- if is_new -%}<span class="bg-ivory text-charcoal border border-sand px-2 py-0.5">New</span>{%- endif -%}
      {%- endif -%}
    </span>
  </a>

  <!-- Details -->
  <div class="space-y-1 text-left flex-1 flex flex-col justify-between">
    <div class="space-y-1">
      {%- if product.type != blank -%}
        <span class="text-[10px] uppercase font-sans tracking-widest text-taupe block">{{ product.type }}</span>
      {%- endif -%}
      <h3 class="font-serif text-sm leading-snug text-charcoal hover:text-olive transition-colors line-clamp-2">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
      {%- if review_count > 0 -%}
        {%- assign review_rating = product.metafields.reviews.rating.value -%}
        <p class="flex items-center gap-1 text-[10px] font-sans text-taupe">
          <svg class="w-3 h-3 text-[#E0A526]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <span class="text-charcoal font-semibold">{{ review_rating.rating | round: 1 }}</span> ({{ review_count }})
        </p>
      {%- endif -%}
      {%- if age_option -%}
        <p class="text-[10px] font-sans text-taupe">Ages {{ age_option.values | join: ' · ' | remove: ' Years' }} yrs</p>
      {%- endif -%}
    </div>
    <div class="flex items-center justify-between gap-2 pt-2 border-t border-sand/40">
      <span class="text-xs font-sans text-charcoal">
        {%- if product.price_varies -%}<span class="text-[10px] text-taupe">From </span>{%- endif -%}
        <span class="font-semibold">{{ product.price | money }}</span>
        {%- if on_sale -%} <s class="text-[10px] text-taupe">{{ product.compare_at_price | money }}</s>{%- endif -%}
      </span>
      {%- if product.available == false -%}
        <span class="text-[10px] uppercase tracking-wider text-taupe">Sold out</span>
      {%- elsif product.has_only_default_variant -%}
        <form method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="px-2.5 py-1 bg-olive text-ivory text-[10px] uppercase tracking-wider hover:bg-taupe transition-colors">
            + Add
          </button>
        </form>
      {%- else -%}
        <a href="{{ product.url }}" class="px-2.5 py-1 border border-olive text-olive text-[10px] uppercase tracking-wider whitespace-nowrap hover:bg-olive hover:text-ivory transition-colors">
          {%- if age_option -%}Choose Age{%- else -%}Choose Options{%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
