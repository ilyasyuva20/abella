<section class="py-14 sm:py-16 bg-[#F5EFE8] border-b border-[#DFCDC0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Heading with Flanking Horizontal Lines -->
    <div class="flex items-center justify-center mb-8">
      <div class="w-16 sm:w-28 md:w-40 h-[1px] bg-[#DFCDC0]"></div>
      <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-[#2C221E] font-normal px-4 sm:px-8 text-center tracking-tight">
        {{ section.settings.heading | default: "Shop by Category" }}
      </h2>
      <div class="w-16 sm:w-28 md:w-40 h-[1px] bg-[#DFCDC0]"></div>
    </div>

    <!-- Sub Group Divider Row (Desktop) -->
    <div class="hidden sm:grid grid-cols-5 gap-4 lg:gap-6 mb-10 items-center">
      <div class="col-span-2 flex items-center justify-center">
        <div class="flex-1 h-[1px] bg-[#DFCDC0]"></div>
        <span class="px-3 lg:px-4 text-[11px] lg:text-[12px] font-sans font-semibold uppercase tracking-[0.22em] text-[#7A6B60] whitespace-nowrap">
          KIDS BOUTIQUE
        </span>
        <div class="flex-1 h-[1px] bg-[#DFCDC0]"></div>
      </div>
      <div class="col-span-3 flex items-center justify-center">
        <div class="flex-1 h-[1px] bg-[#DFCDC0]"></div>
        <span class="px-3 lg:px-4 text-[11px] lg:text-[12px] font-sans font-semibold uppercase tracking-[0.22em] text-[#7A6B60] whitespace-nowrap">
          WOMEN'S COLLECTION
        </span>
        <div class="flex-1 h-[1px] bg-[#DFCDC0]"></div>
      </div>
    </div>

    <!-- Mobile Sub Group Dividers (Clean & Spacious) -->
    <div class="sm:hidden flex flex-wrap justify-center gap-3 mb-6 text-[10px] font-sans font-semibold uppercase tracking-[0.18em] text-[#7A6B60]">
      <span class="px-3 py-1 bg-[#EADCD0] rounded-full border border-[#DFCDC0]">KIDS BOUTIQUE (2)</span>
      <span class="px-3 py-1 bg-[#EADCD0] rounded-full border border-[#DFCDC0]">WOMEN'S COLLECTION (3)</span>
    </div>

    <!-- FLEUR Top-Arched Category Cards: 2 Kids Boutique + 3 Women's Collection -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 sm:gap-4 lg:gap-5 items-stretch">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign cat_default_link = '#featured' -%}
          {%- if block.settings.title contains 'Custom' -%}{%- assign cat_default_link = '#custom' -%}{%- endif -%}
          <a href="{{ block.settings.link | default: cat_default_link }}" class="category-card group bg-[#EADCD0] p-3 sm:p-4 flex flex-col items-center text-center space-y-3 rounded-t-[70px] sm:rounded-t-[90px] rounded-b-xl border border-[#DFCDC0]/60 hover:bg-[#E5D2C2] shadow-xs hover:shadow-md transition-all duration-300 focus:outline-none" {{ block.shopify_attributes }}>
            
            <!-- FLEUR Signature Top-Arched Frame -->
            <div class="abella-frame w-full aspect-[4/5] rounded-t-[60px] sm:rounded-t-[80px] rounded-b-lg overflow-hidden border border-[#DFCDC0] bg-[#F5EFE8]">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
              {%- else -%}
                {%- assign cat_img = 'cat-frocks.jpg' -%}
                {%- if block.settings.title contains 'Custom' %}{% assign cat_img = 'cat-custom.jpg' %}{% endif -%}
                {%- if block.settings.title contains 'Birthday' %}{% assign cat_img = 'cat-birthday.jpg' %}{% endif -%}
                {%- if block.settings.title contains 'Co-ord' %}{% assign cat_img = 'cat-coords.jpg' %}{% endif -%}
                {%- if block.settings.title contains 'Saree' %}{% assign cat_img = 'cat-sarees.jpg' %}{% endif -%}
                {%- if block.settings.title contains 'Blouse' %}{% assign cat_img = 'cat-blouses.jpg' %}{% endif -%}
                {%- if block.settings.title contains 'Semi' %}{% assign cat_img = 'cat-semi-partywear.jpg' %}{% endif -%}
                <img src="{{ cat_img | asset_url }}" alt="{{ block.settings.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
              {%- endif -%}
            </div>
            
            <div class="space-y-1 py-1">
              <span class="font-serif text-sm sm:text-base font-normal text-[#2C221E] group-hover:text-[#4A3B32] transition-colors leading-tight block">
                {{ block.settings.title }}
              </span>
              <span class="text-[10px] uppercase font-sans tracking-widest text-[#7A6B60] block group-hover:underline">Explore &rarr;</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback FLEUR Arched Cards -->
        <a href="{{ routes.collections_url }}/kids-boutique" class="category-card group bg-[#EADCD0] p-3 sm:p-4 flex flex-col items-center text-center space-y-3 rounded-t-[70px] sm:rounded-t-[90px] rounded-b-xl border border-[#DFCDC0]/60 hover:bg-[#E5D2C2] shadow-xs hover:shadow-md transition-all duration-300 focus:outline-none">
          <div class="abella-frame w-full aspect-[4/5] rounded-t-[60px] sm:rounded-t-[80px] rounded-b-lg overflow-hidden border border-[#DFCDC0] bg-[#F5EFE8]">
            <img src="{{ 'cat-frocks.jpg' | asset_url }}" alt="Readily Available" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
          </div>
          <div class="space-y-1 py-1">
            <span class="font-serif text-sm sm:text-base font-normal text-[#2C221E] group-hover:text-[#4A3B32] transition-colors leading-tight block">Readily Available</span>
            <span class="text-[10px] uppercase font-sans tracking-widest text-[#7A6B60] block group-hover:underline">Explore &rarr;</span>
          </div>
        </a>

        <a href="#custom" class="category-card group bg-[#EADCD0] p-3 sm:p-4 flex flex-col items-center text-center space-y-3 rounded-t-[70px] sm:rounded-t-[90px] rounded-b-xl border border-[#DFCDC0]/60 hover:bg-[#E5D2C2] shadow-xs hover:shadow-md transition-all duration-300 focus:outline-none">
          <div class="abella-frame w-full aspect-[4/5] rounded-t-[60px] sm:rounded-t-[80px] rounded-b-lg overflow-hidden border border-[#DFCDC0] bg-[#F5EFE8]">
            <img src="{{ 'cat-custom.jpg' | asset_url }}" alt="Custom Outfits" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
          </div>
          <div class="space-y-1 py-1">
            <span class="font-serif text-sm sm:text-base font-normal text-[#2C221E] group-hover:text-[#4A3B32] transition-colors leading-tight block">Custom Outfits</span>
            <span class="text-[10px] uppercase font-sans tracking-widest text-[#7A6B60] block group-hover:underline">Explore &rarr;</span>
          </div>
        </a>



        <a href="#women" class="category-card group bg-[#EADCD0] p-3 sm:p-4 flex flex-col items-center text-center space-y-3 rounded-t-[70px] sm:rounded-t-[90px] rounded-b-xl border border-[#DFCDC0]/60 hover:bg-[#E5D2C2] shadow-xs hover:shadow-md transition-all duration-300 focus:outline-none">
          <div class="abella-frame w-full aspect-[4/5] rounded-t-[60px] sm:rounded-t-[80px] rounded-b-lg overflow-hidden border border-[#DFCDC0] bg-[#F5EFE8]">
            <img src="{{ 'cat-sarees.jpg' | asset_url }}" alt="Sarees" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
          </div>
          <div class="space-y-1 py-1">
            <span class="font-serif text-sm sm:text-base font-normal text-[#2C221E] group-hover:text-[#4A3B32] transition-colors leading-tight block">Sarees</span>
            <span class="text-[10px] uppercase font-sans tracking-widest text-[#7A6B60] block group-hover:underline">Explore &rarr;</span>
          </div>
        </a>

        <a href="#women" class="category-card group bg-[#EADCD0] p-3 sm:p-4 flex flex-col items-center text-center space-y-3 rounded-t-[70px] sm:rounded-t-[90px] rounded-b-xl border border-[#DFCDC0]/60 hover:bg-[#E5D2C2] shadow-xs hover:shadow-md transition-all duration-300 focus:outline-none">
          <div class="abella-frame w-full aspect-[4/5] rounded-t-[60px] sm:rounded-t-[80px] rounded-b-lg overflow-hidden border border-[#DFCDC0] bg-[#F5EFE8]">
            <img src="{{ 'cat-blouses.jpg' | asset_url }}" alt="Blouses" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
          </div>
          <div class="space-y-1 py-1">
            <span class="font-serif text-sm sm:text-base font-normal text-[#2C221E] group-hover:text-[#4A3B32] transition-colors leading-tight block">Blouses</span>
            <span class="text-[10px] uppercase font-sans tracking-widest text-[#7A6B60] block group-hover:underline">Explore &rarr;</span>
          </div>
        </a>

        <a href="#women" class="category-card group bg-[#EADCD0] p-3 sm:p-4 flex flex-col items-center text-center space-y-3 rounded-t-[70px] sm:rounded-t-[90px] rounded-b-xl border border-[#DFCDC0]/60 hover:bg-[#E5D2C2] shadow-xs hover:shadow-md transition-all duration-300 focus:outline-none">
          <div class="abella-frame w-full aspect-[4/5] rounded-t-[60px] sm:rounded-t-[80px] rounded-b-lg overflow-hidden border border-[#DFCDC0] bg-[#F5EFE8]">
            <img src="{{ 'cat-semi-partywear.jpg' | asset_url }}" alt="Semi Partywear" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
          </div>
          <div class="space-y-1 py-1">
            <span class="font-serif text-sm sm:text-base font-normal text-[#2C221E] group-hover:text-[#4A3B32] transition-colors leading-tight block">Semi Partywear</span>
            <span class="text-[10px] uppercase font-sans tracking-widest text-[#7A6B60] block group-hover:underline">Explore &rarr;</span>
          </div>
        </a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        { "type": "category", "settings": { "title": "Custom Outfits" } },
        { "type": "category", "settings": { "title": "Readily Available" } },
        { "type": "category", "settings": { "title": "Sarees" } },
        { "type": "category", "settings": { "title": "Blouses" } },
        { "type": "category", "settings": { "title": "Semi Partywear" } }
      ]
    }
  ]
}
{% endschema %}
