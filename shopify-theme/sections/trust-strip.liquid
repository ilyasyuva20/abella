<section class="py-14 sm:py-16 bg-[#F5EFE8] border-b border-[#DFCDC0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
      
      <!-- Feature 1 -->
      <div class="bg-[#EADCD0] p-6 rounded-2xl border border-[#DFCDC0] text-center space-y-3 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="w-12 h-12 rounded-full bg-[#F5EFE8] border border-[#DFCDC0] mx-auto flex items-center justify-center text-[#2C221E]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21z"/></svg>
        </div>
        <h3 class="font-serif text-lg text-[#2C221E] font-normal">{{ section.settings.trust_1_title | default: "Handcrafted Luxury" }}</h3>
        <p class="text-xs text-[#7A6B60] leading-relaxed">{{ section.settings.trust_1_desc | default: "Every stitch crafted with care for two generations." }}</p>
      </div>

      <!-- Feature 2 -->
      <div class="bg-[#EADCD0] p-6 rounded-2xl border border-[#DFCDC0] text-center space-y-3 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="w-12 h-12 rounded-full bg-[#F5EFE8] border border-[#DFCDC0] mx-auto flex items-center justify-center text-[#2C221E]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-7 7m7-7L5 5"/></svg>
        </div>
        <h3 class="font-serif text-lg text-[#2C221E] font-normal">{{ section.settings.trust_2_title | default: "Custom Sizing" }}</h3>
        <p class="text-xs text-[#7A6B60] leading-relaxed">{{ section.settings.trust_2_desc | default: "Tailored perfectly to your unique measurements." }}</p>
      </div>

      <!-- Feature 3 -->
      <div class="bg-[#EADCD0] p-6 rounded-2xl border border-[#DFCDC0] text-center space-y-3 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="w-12 h-12 rounded-full bg-[#F5EFE8] border border-[#DFCDC0] mx-auto flex items-center justify-center text-[#2C221E]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9 9 0 100-18 9 9 0 000 18zM2.25 12h19.5M12 2.25a15.3 15.3 0 014 9.75 15.3 15.3 0 01-4 9.75 15.3 15.3 0 01-4-9.75 15.3 15.3 0 014-9.75z"/></svg>
        </div>
        <h3 class="font-serif text-lg text-[#2C221E] font-normal">{{ section.settings.trust_3_title | default: "Pan-India Delivery" }}</h3>
        <p class="text-xs text-[#7A6B60] leading-relaxed">{{ section.settings.trust_3_desc | default: "Safely packaged and delivered to your doorstep across India." }}</p>
      </div>

      <!-- Feature 4 -->
      <div class="bg-[#EADCD0] p-6 rounded-2xl border border-[#DFCDC0] text-center space-y-3 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="w-12 h-12 rounded-full bg-[#F5EFE8] border border-[#DFCDC0] mx-auto flex items-center justify-center text-[#2C221E]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="font-serif text-lg text-[#2C221E] font-normal">{{ section.settings.trust_4_title | default: "Personal Assistance" }}</h3>
        <p class="text-xs text-[#7A6B60] leading-relaxed">{{ section.settings.trust_4_desc | default: "Dedicated support via WhatsApp & Instagram DM." }}</p>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust / Service Strip",
  "settings": [
    { "type": "text", "id": "trust_1_title", "label": "Trust 1 Title", "default": "Handcrafted Luxury" },
    { "type": "text", "id": "trust_1_desc", "label": "Trust 1 Description", "default": "Every stitch crafted with care for two generations." },
    { "type": "text", "id": "trust_2_title", "label": "Trust 2 Title", "default": "Custom Sizing" },
    { "type": "text", "id": "trust_2_desc", "label": "Trust 2 Description", "default": "Tailored perfectly to your unique measurements." },
    { "type": "text", "id": "trust_3_title", "label": "Trust 3 Title", "default": "Pan-India Delivery" },
    { "type": "text", "id": "trust_3_desc", "label": "Trust 3 Description", "default": "Safely packaged and delivered to your doorstep." },
    { "type": "text", "id": "trust_4_title", "label": "Trust 4 Title", "default": "Personal Assistance" },
    { "type": "text", "id": "trust_4_desc", "label": "Trust 4 Description", "default": "Dedicated support via WhatsApp & Instagram DM." }
  ],
  "presets": [{ "name": "Trust / Service Strip" }]
}
{% endschema %}
