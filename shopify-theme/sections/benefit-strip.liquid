      <div class="flex flex-col items-center justify-center space-y-3 px-3 col-span-2 md:col-span-1">
        <svg class="w-7 h-7 text-[#2E3025] stroke-[1.25]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
        </svg>
        <span class="text-xs sm:text-[13px] font-medium tracking-wide text-[#3D3F30]">{{ section.settings.item_5 }}</span>
