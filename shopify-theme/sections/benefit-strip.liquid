{% schema %}
{
  "name": "Benefit Strip",
  "settings": [
    { "type": "text", "id": "item_1", "label": "Item 1", "default": "Premium Quality" },
    { "type": "text", "id": "item_2", "label": "Item 2", "default": "Custom Orders" },
    { "type": "text", "id": "item_3", "label": "Item 3", "default": "Shipping Across India" },
    { "type": "text", "id": "item_4", "label": "Item 4", "default": "Easy Returns" },
    { "type": "text", "id": "item_5", "label": "Item 5", "default": "Loved by Customers" }
  ],
  "presets": [{ "name": "Benefit Strip" }]
}
