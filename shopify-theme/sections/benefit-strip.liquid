<section class="py-8 bg-[#EADCD0] border-b border-[#DFCDC0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-center divide-y md:divide-y-0 md:divide-x divide-[#DFCDC0]">
      
      <!-- Benefit 1 -->
      <div class="p-3 flex flex-col items-center justify-center space-y-1.5">
        <svg class="w-5 h-5 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21z"/></svg>
        <span class="text-xs font-serif font-medium text-[#2C221E] uppercase tracking-wider">{{ section.settings.item_1 | default: "Premium Quality" }}</span>
      </div>

      <!-- Benefit 2 -->
      <div class="p-3 flex flex-col items-center justify-center space-y-1.5">
        <svg class="w-5 h-5 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-7 7m7-7L5 5"/></svg>
        <span class="text-xs font-serif font-medium text-[#2C221E] uppercase tracking-wider">{{ section.settings.item_2 | default: "Custom Orders" }}</span>
      </div>

      <!-- Benefit 3 -->
      <div class="p-3 flex flex-col items-center justify-center space-y-1.5">
        <svg class="w-5 h-5 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v1.135m12 0c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-12a1.125 1.125 0 01-1.125-1.125v-4.5c0-.621.504-1.125 1.125-1.125h12z"/></svg>
        <span class="text-xs font-serif font-medium text-[#2C221E] uppercase tracking-wider">{{ section.settings.item_3 | default: "Shipping Across India" }}</span>
      </div>

      <!-- Benefit 4 -->
      <div class="p-3 flex flex-col items-center justify-center space-y-1.5">
        <svg class="w-5 h-5 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
        <span class="text-xs font-serif font-medium text-[#2C221E] uppercase tracking-wider">{{ section.settings.item_4 | default: "Easy Returns" }}</span>
      </div>

      <!-- Benefit 5 -->
      <div class="p-3 flex flex-col items-center justify-center space-y-1.5 col-span-2 md:col-span-1">
        <svg class="w-5 h-5 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
        <span class="text-xs font-serif font-medium text-[#2C221E] uppercase tracking-wider">{{ section.settings.item_5 | default: "Loved by Customers" }}</span>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefit Strip",
  "settings": [
    { "type": "text", "id": "item_1", "label": "Item 1", "default": "Premium Quality" },
    { "type": "text", "id": "item_2", "label": "Item 2", "default": "Custom Orders" },
    { "type": "text", "id": "item_3", "label": "Item 3", "default": "Shipping Across India" },
    { "type": "text", "id": "item_4", "label": "Item 4", "default": "Easy Returns" },
    { "type": "text", "id": "item_5", "label": "Item 5", "default": "Loved by Customers" }
  ],
  "presets": [{ "name": "Benefit Strip" }]
}
{% endschema %}
