<section class="bg-[#FAF7F2] border-b border-[#E6E1D7] py-7 sm:py-9">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-y-6 md:gap-y-0 divide-x-0 md:divide-x divide-[#D6D0C4] text-center">
      
      <div class="flex flex-col items-center justify-center space-y-3 px-3">
        <svg class="w-7 h-7 text-[#2E3025]" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <polygon points="6,3 18,3 22,9 12,21 2,9" />
          <line x1="2" y1="9" x2="22" y2="9" />
          <line x1="9" y1="3" x2="6" y2="9" />
          <line x1="15" y1="3" x2="18" y2="9" />
          <line x1="6" y1="9" x2="12" y2="21" />
          <line x1="18" y1="9" x2="12" y2="21" />
        </svg>
        <span class="text-xs sm:text-[13px] font-medium tracking-wide text-[#3D3F30]">{{ section.settings.item_1 }}</span>
      </div>

      <div class="flex flex-col items-center justify-center space-y-3 px-3">
        <svg class="w-7 h-7 text-[#2E3025] stroke-[1.25]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="6" cy="6" r="3" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="6" cy="18" r="3" stroke-linecap="round" stroke-linejoin="round"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.586 7.414L21 19.828M8.586 16.586L21 4.172"/>
        </svg>
        <span class="text-xs sm:text-[13px] font-medium tracking-wide text-[#3D3F30]">{{ section.settings.item_2 }}</span>
      </div>

      <div class="flex flex-col items-center justify-center space-y-3 px-3">
