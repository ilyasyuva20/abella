<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  {% render 'meta-tags' %}
  <title>{{ shop.name }} &ndash; Opening Soon</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="bg-[#FAF7F2] text-[#1A1A1A] font-sans antialiased min-h-screen flex flex-col justify-between">
  <main id="MainContent" class="focus-none flex-grow flex items-center justify-center" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
</body>
</html>
