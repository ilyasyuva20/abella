<div class="bg-[#FAF7F2] min-h-screen py-12 sm:py-16 text-[#2C221E]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Hero Header -->
    <div class="text-center space-y-3 max-w-2xl mx-auto">
      <span class="text-xs uppercase tracking-widest text-[#7A6B60] font-sans font-medium">Personal Assistance</span>
      <h1 class="font-serif text-4xl sm:text-5xl text-[#2C221E] font-normal">
        Get in Touch
      </h1>
      <p class="text-xs sm:text-sm text-[#7A6B60] font-sans leading-relaxed">
        Have questions about custom sizing, fabric options, or order timelines? Connect with our boutique team.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Contact Info Card (5 Cols) -->
      <div class="lg:col-span-5 bg-[#EADCD0] p-6 sm:p-8 rounded-3xl border border-[#DFCDC0] space-y-6 shadow-sm">
        <h2 class="font-serif text-2xl text-[#2C221E] font-normal border-b border-[#DFCDC0] pb-4">
          Boutique Flagship
        </h2>

        <div class="space-y-5 font-sans text-xs text-[#55473E]">
          
          <div class="flex items-start space-x-3">
            <div class="w-8 h-8 rounded-full bg-[#FAF7F2] border border-[#DFCDC0] flex items-center justify-center text-[#2C221E] flex-shrink-0">
              📍
            </div>
            <div>
              <span class="font-semibold text-[#2C221E] block text-sm">Store Address</span>
              <p class="leading-relaxed mt-0.5">Sebastians Boutique, Main Road, Kerala, India</p>
            </div>
          </div>

          <div class="flex items-start space-x-3">
            <div class="w-8 h-8 rounded-full bg-[#FAF7F2] border border-[#DFCDC0] flex items-center justify-center text-[#2C221E] flex-shrink-0">
              📞
            </div>
            <div>
              <span class="font-semibold text-[#2C221E] block text-sm">Phone & WhatsApp</span>
              <p class="mt-0.5">+91 94468 61646</p>
            </div>
          </div>

          <div class="flex items-start space-x-3">
            <div class="w-8 h-8 rounded-full bg-[#FAF7F2] border border-[#DFCDC0] flex items-center justify-center text-[#2C221E] flex-shrink-0">
              ✉️
            </div>
            <div>
              <span class="font-semibold text-[#2C221E] block text-sm">Email Support</span>
              <p class="mt-0.5">support@abella.co.in</p>
            </div>
          </div>

          <div class="flex items-start space-x-3">
            <div class="w-8 h-8 rounded-full bg-[#FAF7F2] border border-[#DFCDC0] flex items-center justify-center text-[#2C221E] flex-shrink-0">
              🕒
            </div>
            <div>
              <span class="font-semibold text-[#2C221E] block text-sm">Working Hours</span>
              <p class="mt-0.5">Mon - Sat: 9:30 AM - 7:30 PM (IST)</p>
            </div>
          </div>

        </div>

        <!-- Direct Social Action Buttons -->
        <div class="pt-4 border-t border-[#DFCDC0] space-y-2">
          <a href="https://wa.me/919446861646?text=Hi%20Abella%2C%20I%20would%20like%20to%20inquire%20about%20custom%20orders." 
             target="_blank" rel="noopener noreferrer" 
             class="w-full py-3 px-4 rounded-xl bg-[#25D366] text-white font-sans text-xs font-semibold flex items-center justify-center space-x-2 shadow-sm hover:opacity-90 transition-opacity">
            <span>Chat on WhatsApp</span>
          </a>

          <a href="https://instagram.com/abella_by_sebastians" 
             target="_blank" rel="noopener noreferrer" 
             class="w-full py-3 px-4 rounded-xl text-white font-sans text-xs font-semibold flex items-center justify-center space-x-2 shadow-sm hover:opacity-90 transition-opacity" 
             style="background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%,#d6249f 60%,#285AEB 90%);">
            <span>Direct Message on Instagram</span>
          </a>
        </div>

      </div>

      <!-- Contact Form (7 Cols) -->
      <div class="lg:col-span-7 bg-[#EADCD0] p-6 sm:p-8 rounded-3xl border border-[#DFCDC0] shadow-sm space-y-6">
        <h2 class="font-serif text-2xl text-[#2C221E] font-normal border-b border-[#DFCDC0] pb-4">
          Send Us a Message
        </h2>

        {% form 'contact', class: 'space-y-4 font-sans text-xs' %}
          {% if form.posted_successfully? %}
            <div class="p-4 bg-[#2C221E] text-white rounded-xl text-xs font-medium">
              Thank you for contacting Abella! Our team will get back to you shortly.
            </div>
          {% endif %}

          {{ form.errors | default_errors }}

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="ContactName" class="font-semibold uppercase tracking-wider text-[#2C221E]">Your Name</label>
              <input type="text" id="ContactName" name="contact[name]" required placeholder="Full Name" 
                     class="w-full bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl p-3 text-xs text-[#2C221E] focus:outline-none focus:ring-1 focus:ring-[#2C221E]">
            </div>

            <div class="space-y-1.5">
              <label for="ContactEmail" class="font-semibold uppercase tracking-wider text-[#2C221E]">Email Address</label>
              <input type="email" id="ContactEmail" name="contact[email]" required placeholder="name@example.com" 
                     class="w-full bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl p-3 text-xs text-[#2C221E] focus:outline-none focus:ring-1 focus:ring-[#2C221E]">
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="ContactPhone" class="font-semibold uppercase tracking-wider text-[#2C221E]">Phone / WhatsApp Number</label>
            <input type="tel" id="ContactPhone" name="contact[phone]" placeholder="+91 94468 61646" 
                   class="w-full bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl p-3 text-xs text-[#2C221E] focus:outline-none focus:ring-1 focus:ring-[#2C221E]">
          </div>

          <div class="space-y-1.5">
            <label for="ContactMessage" class="font-semibold uppercase tracking-wider text-[#2C221E]">Message / Custom Requirement</label>
            <textarea id="ContactMessage" name="contact[body]" rows="4" required placeholder="Tell us about the outfit, date of event, or custom measurements..." 
                      class="w-full bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl p-3 text-xs text-[#2C221E] focus:outline-none focus:ring-1 focus:ring-[#2C221E]"></textarea>
          </div>

          <button type="submit" class="w-full py-3.5 bg-[#2C221E] text-white text-xs font-semibold uppercase tracking-widest rounded-xl hover:bg-[#4A3B32] transition-colors shadow-sm">
            Send Message
          </button>
        {% endform %}

      </div>

    </div>

  </div>
</div>
