<div class="bg-[#FAF7F2] min-h-screen py-10 sm:py-14 text-[#2C221E]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Addresses Header -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 border-b border-[#DFCDC0] pb-6">
      <div class="text-center sm:text-left space-y-1">
        <span class="text-xs uppercase tracking-widest text-[#7A6B60] font-sans font-medium">Account Settings</span>
        <h1 class="font-serif text-3xl sm:text-4xl text-[#2C221E] font-normal">Your Saved Addresses</h1>
      </div>

      <a href="{{ routes.account_url }}" class="text-xs font-sans font-semibold uppercase tracking-wider text-[#7A6B60] hover:text-[#2C221E] transition-colors">
        &larr; Back to Account Dashboard
      </a>
    </div>

    <!-- Address Book List -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {% for address in customer.addresses %}
        <div class="bg-[#EADCD0] p-6 rounded-2xl border border-[#DFCDC0] space-y-4 shadow-xs relative">
          {% if address == customer.default_address %}
            <span class="absolute top-4 right-4 bg-[#2C221E] text-white text-[10px] uppercase font-semibold tracking-wider px-2.5 py-0.5 rounded-full">
              Default Address
            </span>
          {% endif %}

          <div class="space-y-1 text-xs font-sans text-[#55473E] pt-2">
            <h3 class="font-serif text-xl font-normal text-[#2C221E]">{{ address.name }}</h3>
            <p>{{ address.company }}</p>
            <p>{{ address.street }}</p>
            <p>{{ address.city }}, {{ address.province_code }} {{ address.zip }}</p>
            <p>{{ address.country }}</p>
            <p class="pt-1 text-[#7A6B60]">{{ address.phone }}</p>
          </div>

          <div class="flex items-center space-x-3 pt-2 border-t border-[#DFCDC0]/60 font-sans text-xs">
            <button type="button" onclick="document.getElementById('EditAddress_{{ address.id }}').classList.toggle('hidden')" class="font-semibold text-[#2C221E] hover:underline">
              Edit
            </button>
            <span class="text-[#DFCDC0]">|</span>
            <form class="address-delete-form inline" method="post" action="/account/addresses/{{ address.id }}">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" onclick="return confirm('Are you sure you want to delete this address?');" class="text-[#7A6B60] hover:text-red-700 font-semibold">
                Delete
              </button>
            </form>
          </div>

          <!-- Edit Address Drawer Form -->
          <div id="EditAddress_{{ address.id }}" class="hidden pt-4 border-t border-[#DFCDC0] space-y-3 font-sans text-xs">
            {% form 'customer_address', address, class: 'space-y-3' %}
              <div class="grid grid-cols-2 gap-2">
                <input type="text" name="address[first_name]" value="{{ form.first_name }}" placeholder="First Name" class="bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl p-2.5">
                <input type="text" name="address[last_name]" value="{{ form.last_name }}" placeholder="Last Name" class="bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl p-2.5">
              </div>
              <input type="text" name="address[address1]" value="{{ form.address1 }}" placeholder="Address 1" class="w-full bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl p-2.5">
              <input type="text" name="address[city]" value="{{ form.city }}" placeholder="City" class="w-full bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl p-2.5">
              <input type="text" name="address[phone]" value="{{ form.phone }}" placeholder="Phone" class="w-full bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl p-2.5">
              <div class="flex gap-2 pt-1">
                <button type="submit" class="px-4 py-2 bg-[#2C221E] text-white font-semibold rounded-xl">Save Changes</button>
                <button type="button" onclick="document.getElementById('EditAddress_{{ address.id }}').classList.add('hidden')" class="px-4 py-2 bg-[#FAF7F2] text-[#2C221E] rounded-xl border border-[#DFCDC0]">Cancel</button>
              </div>
            {% endform %}
          </div>

        </div>
      {% else %}
        <div class="col-span-full text-center py-12 bg-[#EADCD0]/30 rounded-2xl border border-[#DFCDC0] text-xs font-sans text-[#7A6B60]">
          You have no saved addresses yet.
        </div>
      {% endfor %}
    </div>

  </div>
</div>
