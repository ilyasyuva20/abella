        <script>
          (function () {
            var box = document.getElementById('CustomizationChat');
            if (!box) return;
            function selectedOptions() {
              var picked = [];
              document.querySelectorAll('input[type="radio"][data-option-name]:checked').forEach(function (el) {
                picked.push(el.getAttribute('data-option-name') + ': ' + el.value);
              });
              return picked;
            }
            // Same text for WhatsApp and Instagram: name, price, selected options, then the product link
            function message() {
              var d = box.dataset;
              var priceEl = document.getElementById('ProductPrice');
              var price = (priceEl && priceEl.textContent.replace(/\s+/g, ' ').trim()) || d.price;
              var lines = ['Hi Abella, I would like to customize this product:', '', d.title, 'Price: ' + price];
              selectedOptions().forEach(function (o) { lines.push(o); });
              lines.push('', 'Product link: ' + d.url);
              return lines.join('\n');
            }
            function note(text) {
              var n = document.getElementById('CustomizationChatNote');
              n.textContent = text;
              n.classList.remove('hidden');
              clearTimeout(note.t);
              note.t = setTimeout(function () { n.classList.add('hidden'); }, 6000);
            }
            box.querySelector('[data-chat="whatsapp"]').addEventListener('click', function () {
              this.href = 'https://wa.me/919446861646?text=' + encodeURIComponent(message());
            });
            // Copy synchronously inside the click so it still works when Instagram opens in a new tab or the app
            function copyText(text) {
              var ok = false;
              try {
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.setAttribute('readonly', '');
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                ta.setSelectionRange(0, text.length);
                ok = document.execCommand('copy');
                document.body.removeChild(ta);
              } catch (e) {}
              if (!ok && navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).catch(function () {});
                ok = true;
              }
              return ok;
            }
            box.querySelector('[data-chat="instagram"]').addEventListener('click', function () {
              // Instagram does not pre-fill DMs from websites, so the details are copied for the customer to paste.
              var text = message();
              this.href = 'https://ig.me/m/little_bella___?text=' + encodeURIComponent(text);
              if (copyText(text)) {
                note('Product link & selected options copied - paste them in the Instagram chat.');
              } else {
                note('Please mention "' + box.dataset.title + '" in the Instagram chat.');
              }
            });
          })();
        </script>

