<div class="bg-[#FAF7F2] min-h-screen py-10 sm:py-14 text-[#2C221E]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumbs -->
    <nav class="text-xs text-[#7A6B60] mb-8 font-sans flex items-center space-x-2">
      <a href="{{ routes.root_url }}" class="hover:text-[#2C221E] transition-colors">Home</a>
      <span>/</span>
      {% if collection %}
        <a href="{{ collection.url }}" class="hover:text-[#2C221E] transition-colors">{{ collection.title }}</a>
        <span>/</span>
      {% else %}
        <a href="/collections/all" class="hover:text-[#2C221E] transition-colors">Collections</a>
        <span>/</span>
      {% endif %}
      <span class="text-[#2C221E] font-medium truncate">{{ product.title }}</span>
    </nav>

    <!-- Main Product Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      
      <!-- Product Media Gallery (Left Column - 7 Cols) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="abella-frame bg-[#EADCD0] rounded-2xl p-4 border border-[#DFCDC0] shadow-sm relative overflow-hidden group">
          {% if product.featured_image %}
            <button type="button" id="GalleryOpen" aria-label="View full screen" class="block w-full cursor-zoom-in touch-pan-y">
              <img id="mainProductImage"
                   src="{{ product.featured_image | image_url: width: 1200 }}"
                   alt="{{ product.title | escape }}"
                   class="w-full h-auto max-h-[650px] object-cover rounded-xl transition-all duration-500 group-hover:scale-105">
            </button>
            <span class="pointer-events-none absolute bottom-7 right-7 inline-flex items-center gap-1.5 bg-[#FAF7F2]/90 text-[#2C221E] text-[10px] uppercase font-semibold tracking-widest px-3 py-1.5 rounded-full shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.2-5.2M10.5 7.5v6m3-3h-6M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/></svg>
              Tap to zoom
            </span>
            {% if product.images.size > 1 %}
              <span id="GalleryCounter" class="pointer-events-none absolute bottom-7 left-7 bg-[#2C221E]/80 text-[#F5EFE8] text-[10px] font-semibold tracking-widest px-2.5 py-1 rounded-full lg:hidden">1 / {{ product.images.size }}</span>
            {% endif %}
          {% else %}
            <div class="w-full aspect-[3/4] bg-[#F5EFE8] rounded-xl flex items-center justify-center text-[#7A6B60] text-sm font-serif">
              High-Resolution Image Coming Soon
            </div>
          {% endif %}
          <span class="absolute top-7 left-7 bg-[#2C221E] text-[#F5EFE8] text-[10px] uppercase font-semibold tracking-widest px-3 py-1 rounded-full">
            Handcrafted Luxury
          </span>
        </div>

        <!-- Media Thumbnails Carousel -->
        {% if product.images.size > 1 %}
          <div class="flex items-center space-x-3 overflow-x-auto pb-2 scrollbar-thin">
            {% for image in product.images %}
              <button type="button" data-gallery-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}"
                      class="flex-shrink-0 w-20 h-24 rounded-lg bg-[#EADCD0] border-2 p-1 overflow-hidden transition-all {% if forloop.first %}border-[#2C221E]{% else %}border-[#DFCDC0] opacity-70 hover:opacity-100{% endif %}">
                <img src="{{ image | image_url: width: 200 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover rounded-md">
              </button>
            {% endfor %}
          </div>
        {% endif %}

        <!-- Full-screen gallery: swipe / arrows to browse, tap image to zoom -->
        {% if product.featured_image %}
          <dialog id="GalleryLightbox" aria-label="{{ product.title | escape }} images"
                  class="!m-0 w-screen h-[100dvh] max-w-none max-h-none p-0 bg-[#1A1411] text-white backdrop:bg-black">
            <div class="relative w-full h-full flex items-center justify-center overflow-hidden">
              <div id="LightboxStage" class="w-full h-full overflow-auto flex items-center justify-center touch-pan-y">
                <img id="LightboxImage" src="{{ product.featured_image | image_url: width: 2000 }}" alt="{{ product.title | escape }}"
                     class="max-w-full max-h-full object-contain cursor-zoom-in select-none transition-transform duration-200">
              </div>
              <button type="button" data-lightbox-close aria-label="Close" class="absolute top-4 right-4 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 inline-flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
              {% if product.images.size > 1 %}
                <button type="button" data-lightbox-step="-1" aria-label="Previous image" class="absolute left-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 inline-flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <button type="button" data-lightbox-step="1" aria-label="Next image" class="absolute right-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 inline-flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5l7 7-7 7"/></svg>
                </button>
                <span id="LightboxCounter" class="absolute bottom-5 left-1/2 -translate-x-1/2 text-xs font-sans tracking-widest bg-white/10 px-3 py-1 rounded-full">1 / {{ product.images.size }}</span>
              {% endif %}
            </div>
          </dialog>
          <script>
            (function () {
              var images = [
                {%- for image in product.images -%}
                  { "main": {{ image | image_url: width: 1200 | json }}, "full": {{ image | image_url: width: 2000 | json }} }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ];
              var current = 0;
              var main = document.getElementById('mainProductImage');
              var thumbs = document.querySelectorAll('[data-gallery-thumb]');
              var counter = document.getElementById('GalleryCounter');
              var box = document.getElementById('GalleryLightbox');
              var stage = document.getElementById('LightboxStage');
              var big = document.getElementById('LightboxImage');
              var boxCounter = document.getElementById('LightboxCounter');
              var zoomed = false;

              function setZoom(on, e) {
                zoomed = on;
                if (on && e) {
                  var r = big.getBoundingClientRect();
                  big.style.transformOrigin = ((e.clientX - r.left) / r.width * 100) + '% ' + ((e.clientY - r.top) / r.height * 100) + '%';
                }
                big.style.transform = on ? 'scale(2.5)' : '';
                big.classList.toggle('cursor-zoom-in', !on);
                big.classList.toggle('cursor-zoom-out', on);
              }
              function show(i) {
                if (!images.length) return;
                current = (i + images.length) % images.length;
                main.src = images[current].main;
                big.src = images[current].full;
                setZoom(false);
                var label = (current + 1) + ' / ' + images.length;
                if (counter) counter.textContent = label;
                if (boxCounter) boxCounter.textContent = label;
                thumbs.forEach(function (t, n) {
                  var on = n === current;
                  t.classList.toggle('border-[#2C221E]', on);
                  t.classList.toggle('border-[#DFCDC0]', !on);
                  t.classList.toggle('opacity-70', !on);
                  // Scroll only the thumbnail strip, not the page
                  if (on) t.parentElement.scrollTo({ left: t.offsetLeft - t.parentElement.offsetLeft, behavior: 'smooth' });
                });
              }
              // Used by the variant script to jump to a variant's image
              window.AbellaGallery = {
                showSrc: function (src) {
                  var base = function (u) { return u.split('?')[0].replace(/_\d+x\d*(?=\.)/, ''); };
                  var i = images.findIndex(function (img) { return base(img.main) === base(src); });
                  if (i > -1) show(i); else main.src = src;
                }
              };

              thumbs.forEach(function (t) { t.addEventListener('click', function () { show(+t.dataset.galleryThumb); }); });

              // Swipe on the main image (phones)
              function swipe(el, onSwipe) {
                var x0 = null, y0 = null;
                el.addEventListener('touchstart', function (e) { if (e.touches.length === 1) { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; } else { x0 = null; } }, { passive: true });
                el.addEventListener('touchend', function (e) {
                  if (x0 === null) return;
                  var dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
                  x0 = null;
                  if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) { el.dataset.swiped = '1'; onSwipe(dx < 0 ? 1 : -1); }
                });
              }
              var opener = document.getElementById('GalleryOpen');
              swipe(opener, function (dir) { show(current + dir); });
              opener.addEventListener('click', function () {
                if (opener.dataset.swiped) { delete opener.dataset.swiped; return; }
                big.src = images[current] ? images[current].full : main.src;
                box.showModal();
              });

              // Lightbox controls
              swipe(stage, function (dir) { if (!zoomed && window.visualViewport && window.visualViewport.scale <= 1) show(current + dir); });
              big.addEventListener('click', function (e) {
                if (stage.dataset.swiped) { delete stage.dataset.swiped; return; }
                setZoom(!zoomed, e);
              });
              big.addEventListener('mousemove', function (e) {
                if (!zoomed) return;
                var r = big.getBoundingClientRect();
                big.style.transformOrigin = ((e.clientX - r.left) / r.width * 100) + '% ' + ((e.clientY - r.top) / r.height * 100) + '%';
              });
              box.querySelector('[data-lightbox-close]').addEventListener('click', function () { box.close(); });
              box.querySelectorAll('[data-lightbox-step]').forEach(function (b) {
                b.addEventListener('click', function () { show(current + (+b.dataset.lightboxStep)); });
              });
              box.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowRight') show(current + 1);
                if (e.key === 'ArrowLeft') show(current - 1);
              });
              box.addEventListener('close', function () { setZoom(false); });
            })();
          </script>
        {% endif %}
      </div>

      <!-- Product Meta & Purchase Form (Right Column - 5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="border-b border-[#DFCDC0] pb-6 space-y-3">
          <div class="flex items-center justify-between gap-3">
            <span class="text-xs uppercase tracking-widest text-[#7A6B60] font-sans font-medium block">
              {{ product.type | default: "Custom Boutique Fit" }}
            </span>

            <!-- Product Share (native share sheet on phones, menu on desktop) -->
            {%- capture share_url -%}{{ shop.url }}{{ product.url }}{%- endcapture -%}
            {%- capture share_text -%}{{ product.title }} – {{ product.selected_or_first_available_variant.price | money | strip_html }} at {{ shop.name }}{%- endcapture -%}
            <div id="ProductShare" class="relative flex-shrink-0" data-url="{{ share_url | escape }}" data-title="{{ product.title | escape }}" data-text="{{ share_text | escape }}">
              <button type="button" id="ProductShareButton" aria-haspopup="true" aria-expanded="false" aria-controls="ProductShareMenu"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[#DFCDC0] bg-[#FAF7F2] text-[#2C221E] text-[11px] font-sans font-semibold uppercase tracking-wider hover:bg-[#EADCD0] transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"/></svg>
                <span>Share</span>
              </button>
              <div id="ProductShareMenu" role="menu" class="hidden absolute right-0 top-full mt-2 z-30 w-56 bg-[#FAF7F2] border border-[#DFCDC0] rounded-xl shadow-lg p-1.5 font-sans text-xs text-[#2C221E]">
                <a role="menuitem" data-share="whatsapp" target="_blank" rel="noopener noreferrer" href="https://wa.me/?text={{ share_text | append: ' ' | append: share_url | url_encode }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#EADCD0] font-medium">
                  <svg class="w-5 h-5 flex-shrink-0 text-[#25D366] fill-current" viewBox="0 0 448 512" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>WhatsApp
                </a>
                <a role="menuitem" target="_blank" rel="noopener noreferrer" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#EADCD0] font-medium">
                  <svg class="w-5 h-5 flex-shrink-0 text-[#1877F2] fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>Facebook
                </a>
                <a role="menuitem" target="_blank" rel="noopener noreferrer" href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&media={% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | prepend: 'https:' | url_encode }}{% endif %}&description={{ share_text | url_encode }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#EADCD0] font-medium">
                  <svg class="w-5 h-5 flex-shrink-0 text-[#E60023] fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/></svg>Pinterest
                </a>
                <a role="menuitem" target="_blank" rel="noopener noreferrer" href="https://twitter.com/intent/tweet?text={{ share_text | url_encode }}&url={{ share_url | url_encode }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#EADCD0] font-medium">
                  <svg class="w-5 h-5 flex-shrink-0 text-black fill-current p-0.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>X (Twitter)
                </a>
                <button role="menuitem" type="button" data-share="copy" class="w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#EADCD0] font-medium">
                  <svg class="w-5 h-5 flex-shrink-0 text-[#7A6B60]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/></svg><span data-copy-label>Copy link</span>
                </button>
              </div>
            </div>
          </div>
          <script>
            (function () {
              var box = document.getElementById('ProductShare');
              if (!box) return;
              var btn = document.getElementById('ProductShareButton');
              var menu = document.getElementById('ProductShareMenu');
              function toggle(open) {
                menu.classList.toggle('hidden', !open);
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
              }
              btn.addEventListener('click', function () {
                var d = box.dataset;
                // Phones and supported browsers: open the device's own share sheet
                if (navigator.share && window.matchMedia('(pointer: coarse)').matches) {
                  navigator.share({ title: d.title, text: d.text, url: d.url }).catch(function () {});
                  return;
                }
                toggle(menu.classList.contains('hidden'));
              });
              document.addEventListener('click', function (e) { if (!box.contains(e.target)) toggle(false); });
              document.addEventListener('keydown', function (e) { if (e.key === 'Escape') toggle(false); });
              menu.querySelector('[data-share="copy"]').addEventListener('click', function () {
                var label = this.querySelector('[data-copy-label]');
                var done = function () { label.textContent = 'Link copied!'; setTimeout(function () { label.textContent = 'Copy link'; toggle(false); }, 1500); };
                if (navigator.clipboard && navigator.clipboard.writeText) {
                  navigator.clipboard.writeText(box.dataset.url).then(done, function () { window.prompt('Copy this link:', box.dataset.url); });
                } else {
                  window.prompt('Copy this link:', box.dataset.url);
                }
              });
            })();
          </script>
          <h1 class="font-serif text-3xl sm:text-4xl font-normal text-[#2C221E] leading-tight">
            {{ product.title }}
          </h1>

          <!-- Rating summary (reads the standard reviews.rating / reviews.rating_count metafields filled by a reviews app such as Judge.me) -->
          {%- assign review_rating = product.metafields.reviews.rating.value -%}
          {%- assign review_count = product.metafields.reviews.rating_count.value | default: 0 -%}
          <a href="#reviews" class="inline-flex items-center gap-2 text-xs font-sans text-[#7A6B60] hover:text-[#2C221E] transition-colors">
            <span class="relative inline-flex">
              <span class="flex text-[#DFCDC0]"><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg></span>
              {%- if review_rating and review_count > 0 -%}
                {%- assign rating_percent = review_rating.rating | times: 100.0 | divided_by: review_rating.scale_max -%}
                <span class="absolute inset-0 flex overflow-hidden text-[#E0A526]" style="width: {{ rating_percent }}%"><svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg></span>
              {%- endif -%}
            </span>
            {%- if review_rating and review_count > 0 -%}
              <span class="font-semibold text-[#2C221E]">{{ review_rating.rating | round: 1 }}</span>
              <span>({{ review_count }} {{ review_count | pluralize: 'review', 'reviews' }})</span>
            {%- else -%}
              <span>No reviews yet &middot; <span class="underline">Be the first to review</span></span>
            {%- endif -%}
          </a>
          {%- assign current_variant = product.selected_or_first_available_variant -%}
          <div class="flex items-center space-x-4">
            <span id="ProductPrice" class="text-2xl font-serif font-medium text-[#2C221E]">
              {{ current_variant.price | money }}
            </span>
            <span id="ProductComparePrice" class="text-base text-[#7A6B60] line-through font-sans{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}">
              {{ current_variant.compare_at_price | money }}
            </span>
            <span id="ProductSaleBadge" class="text-xs bg-[#2C221E] text-white px-2.5 py-0.5 rounded-full uppercase font-medium tracking-wider{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}">
              Sale
            </span>
          </div>

          <!-- Stock status (updated by the variant script below) -->
          <div id="ProductStock">
          {%- assign stock_variant = product.selected_or_first_available_variant -%}
          {%- if stock_variant.available -%}
            {%- if stock_variant.inventory_management == 'shopify' and stock_variant.inventory_policy == 'deny' and stock_variant.inventory_quantity > 0 and stock_variant.inventory_quantity <= 5 -%}
              <p class="inline-flex items-center gap-2 text-xs font-sans font-semibold text-[#B45309]">
                <span class="w-2 h-2 rounded-full bg-[#F59E0B]"></span>Only {{ stock_variant.inventory_quantity }} left in stock
              </p>
            {%- else -%}
              <p class="inline-flex items-center gap-2 text-xs font-sans font-semibold text-[#15803D]">
                <span class="w-2 h-2 rounded-full bg-[#22C55E]"></span>In Stock
              </p>
            {%- endif -%}
          {%- else -%}
            <p class="inline-flex items-center gap-2 text-xs font-sans font-semibold text-[#B91C1C]">
              <span class="w-2 h-2 rounded-full bg-[#EF4444]"></span>Out of Stock
            </p>
          {%- endif -%}
          </div>

          <!-- Highlights: per-product list from the custom.highlights metafield, with boutique-wide defaults -->
          {%- assign highlights = product.metafields.custom.highlights.value -%}
          {%- if highlights == blank -%}
            {%- assign highlights = 'Handcrafted with care in our boutique|Customisation available on request|Shipped worldwide' | split: '|' -%}
          {%- endif -%}
          <ul class="pt-1 space-y-1.5 font-sans text-xs text-[#55473E]">
            {%- for item in highlights -%}
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 flex-shrink-0 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>{{ item }}</span>
              </li>
            {%- endfor -%}
          </ul>

          <!-- Occasions: custom.occasions metafield, otherwise a default set for kids / women's outfits -->
          {%- assign occasions = product.metafields.custom.occasions.value -%}
          {%- if occasions == blank -%}
            {%- assign is_kids = false -%}
            {%- for tag in product.tags -%}{%- if tag contains 'Age' -%}{%- assign is_kids = true -%}{%- endif -%}{%- endfor -%}
            {%- if is_kids -%}
              {%- assign occasions = 'Birthday|Party|Photoshoot|Festive' | split: '|' -%}
            {%- else -%}
              {%- assign occasions = 'Wedding|Party|Festive' | split: '|' -%}
            {%- endif -%}
          {%- endif -%}
          <div class="flex flex-wrap items-center gap-2 pt-1 font-sans">
            <span class="text-[11px] uppercase tracking-wider text-[#7A6B60] font-semibold">Perfect for</span>
            {%- for occasion in occasions -%}
              <span class="px-2.5 py-1 rounded-full border border-[#DFCDC0] bg-[#F5EFE8] text-[11px] text-[#2C221E]">{{ occasion }}</span>
            {%- endfor -%}
          </div>
        </div>

        <!-- Product Form -->
        {% form 'product', product, class: 'space-y-6' %}
          <input type="hidden" name="id" id="ProductVariantId" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Size Chart trigger (opens #SizeChartDialog below) -->
          {%- capture size_help_text -%}Hi Abella, I need help choosing the right size for: {{ product.title }} - {{ shop.url }}{{ product.url }}{%- endcapture -%}
          <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2 -mb-3">
            <button type="button" id="SizeChartOpen" aria-haspopup="dialog" aria-controls="SizeChartDialog"
                    class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold uppercase tracking-wider text-[#2C221E] underline underline-offset-4 decoration-[#DFCDC0] hover:decoration-[#2C221E] transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 8.25h18v7.5H3zM7 8.25v3M11 8.25v4.5M15 8.25v3M19 8.25v4.5"/></svg>
              <span>Size Chart</span>
            </button>
          </div>

          <!-- Variant Selector -->
          {% unless product.has_only_default_variant %}
            <div class="space-y-4">
              {% for option in product.options_with_values %}
                <div class="space-y-2">
                  <label class="text-xs font-sans font-semibold uppercase tracking-wider text-[#2C221E] block">
                    Select {{ option.name }}
                  </label>
                  <div class="flex flex-wrap gap-2.5">
                    {% for value in option.values %}
                      <label class="cursor-pointer">
                        <input type="radio" name="option-{{ option.position }}" data-option-name="{{ option.name | escape }}" value="{{ value | escape }}" 
                               {% if option.selected_value == value %}checked{% endif %} 
                               class="peer sr-only">
                        <span class="px-4 py-2.5 text-xs font-sans rounded-xl border border-[#DFCDC0] bg-[#F5EFE8] text-[#2C221E] peer-checked:bg-[#2C221E] peer-checked:text-white peer-checked:border-[#2C221E] transition-all inline-block shadow-xs hover:border-[#2C221E]">
                          {{ value }}
                        </span>
                      </label>
                    {% endfor %}
                  </div>
                  {%- assign option_name = option.name | downcase -%}
                  {%- if option_name contains 'age' or option_name contains 'size' -%}
                    <!-- Filled by the size chart script with the measurements for the selected age -->
                    <p data-size-fit class="hidden text-[11px] font-sans text-[#55473E] bg-[#F5EFE8] border border-[#DFCDC0] rounded-lg px-3 py-2"></p>
                  {%- endif -%}
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <!-- Quantity Selector & Submit CTA -->
          <div class="space-y-3">
            <label class="text-xs font-sans font-semibold uppercase tracking-wider text-[#2C221E] block">Quantity</label>
            <div class="flex items-center space-x-3">
              <div class="flex items-center border border-[#DFCDC0] bg-[#F5EFE8] rounded-xl overflow-hidden h-12">
                <button type="button" onclick="let q=document.getElementById('Quantity'); if(q.value>1)q.value--" class="px-3.5 text-[#2C221E] font-bold text-base hover:bg-[#EADCD0] transition-colors">-</button>
                <input type="number" id="Quantity" name="quantity" value="1" min="1" class="w-12 text-center text-xs font-sans bg-transparent border-none focus:outline-none text-[#2C221E]">
                <button type="button" onclick="let q=document.getElementById('Quantity'); q.value++" class="px-3.5 text-[#2C221E] font-bold text-base hover:bg-[#EADCD0] transition-colors">+</button>
              </div>

              <button type="submit" name="add" class="flex-1 h-12 bg-[#2C221E] text-[#FAF7F2] text-xs font-sans font-semibold uppercase tracking-widest rounded-xl hover:bg-[#4A3B32] transition-all shadow-md flex items-center justify-center space-x-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                <span>Add to Shopping Bag</span>
              </button>
            </div>

            <!-- Direct Buy Now CTA -->
            {{ form | payment_button }}

            <!-- Dispatch estimate (business days from custom.dispatch_days, default 10) + returns note -->
            {%- assign dispatch_days = product.metafields.custom.dispatch_days.value | default: 10 -%}
            <div class="rounded-xl border border-[#DFCDC0] bg-[#FAF7F2]/80 px-4 py-3 space-y-1.5 font-sans text-xs text-[#55473E]">
              <p id="DispatchEstimate" data-days="{{ dispatch_days }}" class="flex items-start gap-2">
                <svg class="w-4 h-4 flex-shrink-0 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                <span>Made to order &middot; dispatched within {{ dispatch_days }} business days</span>
              </p>
              <p class="flex items-start gap-2">
                <svg class="w-4 h-4 flex-shrink-0 text-[#2C221E]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                <span>No returns or exchanges on any product &mdash; please check the <button type="button" data-size-chart-link class="underline underline-offset-2 font-semibold text-[#2C221E]">size chart</button> before ordering.</span>
              </p>
            </div>
            <script>
              (function () {
                var el = document.getElementById('DispatchEstimate');
                var days = parseInt(el.dataset.days, 10);
                if (!days) return;
                var d = new Date();
                while (days > 0) { d.setDate(d.getDate() + 1); if (d.getDay() !== 0 && d.getDay() !== 6) days--; }
                var when = d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
                el.querySelector('span').innerHTML = 'Order today &middot; dispatched by <strong class="text-[#2C221E]">' + when + '</strong>';
              })();
            </script>
          </div>
        {% endform %}

        <!-- Size Chart modal: kids get a measurements table (cm / inches) + measuring guide image;
             semi partywear gets the party wear size guide image; other Women's Collection products
             (sarees, blouses) get the saree & blouse size guide image -->
        {%- liquid
          assign women_size_chart = false
          assign party_size_chart = false
          assign product_type_lc = product.type | downcase
          if product_type_lc contains 'saree' or product_type_lc contains 'blouse'
            assign women_size_chart = true
          endif
          if product_type_lc contains 'party'
            assign party_size_chart = true
          endif
          for tag in product.tags
            assign tag_lc = tag | downcase
            if tag_lc == 'women' or tag_lc == 'sarees' or tag_lc == 'saree' or tag_lc == 'blouses' or tag_lc == 'blouse'
              assign women_size_chart = true
            endif
            if tag_lc contains 'semi party' or tag_lc contains 'semi-party' or tag_lc contains 'partywear' or tag_lc contains 'party wear'
              assign party_size_chart = true
            endif
          endfor
        -%}
        {%- capture size_chart_rows -%}
          14 (upto 6M)|43.2|40.7|35.6|0
          16 (6-11M)|45.7|43.2|40.6|0
          18 (1-2yrs)|48.3|45.7|45.7|1
          20 (2-3yrs)|50.8|48.3|50.8|2
          22 (3-4yrs)|54.6|52.1|58.4|3
          24 (4-5yrs)|57.2|54.6|63.5|4
          26 (5-6yrs)|59.7|55.9|66|5
          28 (6-7yrs)|62.2|58.4|68.6|6
          30 (7-8yrs)|63.5|59.7|73.7|7
          32 (8-9yrs)|66.4|62.2|78.7|8
          S (9-10yrs)|68.6|64.8|83.8|9
          M (10-11yrs)|71.1|67.3|88.9|10
        {%- endcapture -%}
        {%- comment -%} Columns: Age | Chest | Waist | Below knee (cm) | age in whole years the row starts at (used to match the Age option) {%- endcomment -%}
        <dialog id="SizeChartDialog" aria-labelledby="SizeChartTitle"
                class="w-[calc(100%-2rem)] max-w-2xl max-h-[90vh] p-0 rounded-2xl border border-[#DFCDC0] bg-[#FAF7F2] text-[#2C221E] shadow-2xl backdrop:bg-[#2C221E]/60">
          <div class="sticky top-0 z-10 flex items-center justify-between gap-4 px-5 sm:px-6 py-4 border-b border-[#DFCDC0] bg-[#FAF7F2]">
            <h2 id="SizeChartTitle" class="font-serif text-2xl font-normal">Size Chart</h2>
            <button type="button" data-size-chart-close aria-label="Close size chart" class="w-9 h-9 inline-flex items-center justify-center rounded-full hover:bg-[#EADCD0] transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="px-5 sm:px-6 py-5 space-y-6 font-sans">
            {%- if party_size_chart -%}
            <img src="{{ 'size-chart-party.jpg' | asset_url }}" alt="Semi party wear size guide (inches): S bust 34 waist 28 hip 38, M 36/30/40, L 38/32/42, XL 40/34/44; measure bust and hips at the fullest part, waist at the narrowest" width="1390" height="1063" class="w-full h-auto rounded-xl border border-[#DFCDC0]">
            <a href="https://wa.me/919446861646?text={{ size_help_text | url_encode }}" target="_blank" rel="noopener noreferrer"
               class="flex items-center justify-center gap-2 w-full py-3 rounded-xl border border-[#25D366] bg-[#25D366]/10 text-[#128C7E] text-xs font-semibold hover:bg-[#25D366]/20 transition-all">
              Need custom sizing? Send us your measurements on WhatsApp
            </a>
            {%- elsif women_size_chart -%}
            <img src="{{ 'size-chart-saree.jpg' | asset_url }}" alt="Size guide: saree length 216 in (5.5 m), width 44 in, blouse piece 36 in; blouse sizes S bust 34 waist 28 hip 38, M 36/30/40, L 38/32/42, XL 40/34/44 inches" width="1386" height="1065" class="w-full h-auto rounded-xl border border-[#DFCDC0]">
            <a href="https://wa.me/919446861646?text={{ size_help_text | url_encode }}" target="_blank" rel="noopener noreferrer"
               class="flex items-center justify-center gap-2 w-full py-3 rounded-xl border border-[#25D366] bg-[#25D366]/10 text-[#128C7E] text-xs font-semibold hover:bg-[#25D366]/20 transition-all">
              Need custom blouse sizing? Send us your measurements on WhatsApp
            </a>
            {%- else -%}
            <div class="flex items-center justify-between gap-3">
              <p class="text-xs text-[#7A6B60]">Body measurements by age</p>
              <div class="inline-flex rounded-full border border-[#DFCDC0] bg-[#F5EFE8] p-0.5 text-[11px] font-semibold uppercase tracking-wider" role="group" aria-label="Units">
                <button type="button" data-unit="cm" aria-pressed="true" class="px-3 py-1 rounded-full aria-pressed:bg-[#2C221E] aria-pressed:text-white transition-colors">cm</button>
                <button type="button" data-unit="in" aria-pressed="false" class="px-3 py-1 rounded-full aria-pressed:bg-[#2C221E] aria-pressed:text-white transition-colors">inches</button>
