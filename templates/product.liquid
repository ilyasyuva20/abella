                    <th scope="col" class="px-3 py-2.5 text-left font-semibold">Age</th>
                    <th scope="col" class="px-3 py-2.5 font-semibold">Chest</th>
                    <th scope="col" class="px-3 py-2.5 font-semibold">Waist</th>
                    <th scope="col" class="px-3 py-2.5 font-semibold">Below Knee</th>
                  </tr>
                </thead>
                <tbody>
                  {%- assign size_chart_lines = size_chart_rows | strip | newline_to_br | split: '<br />' -%}
                  {%- for line in size_chart_lines -%}
                    {%- assign cells = line | strip | split: '|' -%}
                    <tr data-age-from="{{ cells[4] }}" class="border-t border-[#DFCDC0] odd:bg-[#F5EFE8] data-[match]:bg-[#EADCD0] data-[match]:font-semibold">
                      <th scope="row" class="px-3 py-2.5 text-left font-semibold whitespace-nowrap">{{ cells[0] }}</th>
                      {%- for i in (1..3) -%}
                        {%- assign cm = cells[i] | times: 1.0 -%}
                        <td class="px-3 py-2.5" data-cm="{{ cm | round: 1 }}" data-in="{{ cm | divided_by: 2.54 | round: 1 }}">{{ cm | round: 1 }}</td>
                      {%- endfor -%}
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
