            <p data-size-fit-note class="hidden -mt-3 text-[11px] text-[#7A6B60]">Highlighted rows match the age you selected.</p>
            <a href="https://wa.me/919446861646?text={{ size_help_text | url_encode }}" target="_blank" rel="noopener noreferrer"
               class="flex items-center justify-center gap-2 w-full py-3 rounded-xl border border-[#25D366] bg-[#25D366]/10 text-[#128C7E] text-xs font-semibold hover:bg-[#25D366]/20 transition-all">
              Not sure of the size? Send us your child's measurements on WhatsApp
            </a>
            <img src="{{ 'size-chart.jpg' | asset_url }}" alt="How to measure: chest, waist, hips and dress lengths – floor, tia, below knee, knee and short length" loading="lazy" width="1254" height="1254" class="w-full h-auto rounded-xl border border-[#DFCDC0]">
            {%- endif -%}
          </div>
        </dialog>
        <script>
          (function () {
            var dialog = document.getElementById('SizeChartDialog');
            var open = document.getElementById('SizeChartOpen');
            if (!dialog || !open) return;
            open.addEventListener('click', function () { dialog.showModal(); });
            // Inline "size chart" links elsewhere on the page (some render after this script)
            document.addEventListener('click', function (e) { if (e.target.closest('[data-size-chart-link]')) dialog.showModal(); });

            // Match the selected Age option ("0-1 Years", "2-3 Years"...) to chart rows and show the fit under the options
            var unit = 'cm';
            function rangeText(rows, col) {
              var vals = rows.map(function (r) { return r.cells[col].dataset[unit]; });
              var lo = vals[0], hi = vals[vals.length - 1];
              return (lo === hi ? lo : lo + '–' + hi) + ' ' + (unit === 'cm' ? 'cm' : 'in');
            }
            function updateFit() {
              var fit = document.querySelector('[data-size-fit]');
              if (!fit) return;
              var radio = fit.parentElement.querySelector('input[type="radio"]:checked');
              var m = radio && radio.value.match(/(\d+)\s*(?:-|to)\s*(\d+)/i);
              var rows = [];
              dialog.querySelectorAll('tr[data-age-from]').forEach(function (tr) {
                var from = +tr.dataset.ageFrom;
                var match = m && from >= +m[1] && from < +m[2];
                tr.toggleAttribute('data-match', !!match);
                if (match) rows.push(tr);
              });
              var note = dialog.querySelector('[data-size-fit-note]');
              if (note) note.classList.toggle('hidden', !rows.length);
              if (!rows.length) { fit.classList.add('hidden'); return; }
              fit.innerHTML = '<span class="font-semibold text-[#2C221E]">Fits:</span> Chest ' + rangeText(rows, 1) +
                ' &middot; Waist ' + rangeText(rows, 2) + ' &middot; Below knee length ' + rangeText(rows, 3);
              fit.classList.remove('hidden');
            }
            document.querySelectorAll('input[type="radio"][data-option-name]').forEach(function (r) { r.addEventListener('change', updateFit); });
            updateFit();
            dialog.querySelector('[data-size-chart-close]').addEventListener('click', function () { dialog.close(); });
            // Close when clicking the backdrop
            dialog.addEventListener('click', function (e) { if (e.target === dialog) dialog.close(); });
            dialog.querySelectorAll('[data-unit]').forEach(function (btn) {
              btn.addEventListener('click', function () {
                unit = btn.dataset.unit;
                dialog.querySelectorAll('[data-unit]').forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
                dialog.querySelectorAll('td[data-cm]').forEach(function (td) { td.textContent = td.dataset[unit]; });
                updateFit();
              });
            });
          })();
        </script>

        <!-- Variant data + switching: keeps price, stock, cart variant, image and share/chat details in sync with the selected options -->
        <script type="application/json" id="ProductVariantsJSON">
          [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id }},
                "options": {{ variant.options | json }},
                "price": {{ variant.price }},
                "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                "available": {{ variant.available }},
                "low_stock": {% if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 5 %}{{ variant.inventory_quantity }}{% else %}0{% endif %},
                "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
        <script>
          (function () {
            var variants = JSON.parse(document.getElementById('ProductVariantsJSON').textContent);
            var moneyFormat = {{ shop.money_format | strip_html | json }};
            var radios = document.querySelectorAll('input[type="radio"][data-option-name]');
            if (!radios.length) return;

            function formatMoney(cents) {
              var value = (cents / 100);
              var withDecimals = value.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
              var noDecimals = Math.round(value).toLocaleString('en-IN');
              return moneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/, function (_, key) {
                return key.indexOf('no_decimals') !== -1 ? noDecimals : withDecimals;
              });
            }
            function stockHTML(v) {
              if (!v.available) return '<p class="inline-flex items-center gap-2 text-xs font-sans font-semibold text-[#B91C1C]"><span class="w-2 h-2 rounded-full bg-[#EF4444]"></span>Out of Stock</p>';
              if (v.low_stock) return '<p class="inline-flex items-center gap-2 text-xs font-sans font-semibold text-[#B45309]"><span class="w-2 h-2 rounded-full bg-[#F59E0B]"></span>Only ' + v.low_stock + ' left in stock</p>';
              return '<p class="inline-flex items-center gap-2 text-xs font-sans font-semibold text-[#15803D]"><span class="w-2 h-2 rounded-full bg-[#22C55E]"></span>In Stock</p>';
            }
            function selected() {
              var groups = {};
              radios.forEach(function (r) { if (r.checked) groups[r.name] = r.value; });
              return Object.keys(groups).sort().map(function (k) { return groups[k]; });
            }
            function update() {
              var opts = selected();
              var v = variants.find(function (x) { return x.options.join('||') === opts.join('||'); });
              var addBtn = document.querySelector('button[name="add"]');
              if (!v) {
                if (addBtn) { addBtn.disabled = true; addBtn.classList.add('opacity-50'); }
                document.getElementById('ProductStock').innerHTML = '<p class="text-xs font-sans font-semibold text-[#B91C1C]">Unavailable</p>';
                return;
              }
              document.getElementById('ProductVariantId').value = v.id;
              var priceText = formatMoney(v.price);
              document.getElementById('ProductPrice').textContent = priceText;
              var onSale = v.compare_at_price > v.price;
              var cmp = document.getElementById('ProductComparePrice');
              cmp.textContent = onSale ? formatMoney(v.compare_at_price) : '';
              cmp.classList.toggle('hidden', !onSale);
              document.getElementById('ProductSaleBadge').classList.toggle('hidden', !onSale);
              document.getElementById('ProductStock').innerHTML = stockHTML(v);
              if (addBtn) { addBtn.disabled = !v.available; addBtn.classList.toggle('opacity-50', !v.available); }
              if (v.image) {
                if (window.AbellaGallery) window.AbellaGallery.showSrc(v.image);
                else { var img = document.getElementById('mainProductImage'); if (img) img.src = v.image; }
              }
              var chat = document.getElementById('CustomizationChat');
              if (chat) chat.dataset.price = priceText;
              var share = document.getElementById('ProductShare');
              if (share) share.dataset.text = share.dataset.title + ' \u2013 ' + priceText + ' at {{ shop.name | escape }}';
              var url = new URL(window.location.href);
              url.searchParams.set('variant', v.id);
              window.history.replaceState({}, '', url.toString());
            }
            radios.forEach(function (r) { r.addEventListener('change', update); });
          })();
        </script>

