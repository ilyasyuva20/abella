<div class="max-w-md w-full mx-auto p-6 sm:p-10 text-center space-y-6">
  <div class="space-y-2">
    <h1 class="font-serif text-4xl text-[#1A1A1A] tracking-widest uppercase">ABELLA</h1>
    <p class="text-xs text-[#696652] tracking-[0.2em] uppercase">Two Generations | One Beautiful Story</p>
  </div>
  
  <div class="bg-white p-8 border border-[#E5DFD5] shadow-xs space-y-5">
    <h2 class="font-serif text-2xl text-[#222220]">Opening Soon</h2>
    <p class="text-xs text-[#555340] leading-relaxed">
      Our online boutique is currently under preparation. Enter password to preview the store.
    </p>

    {% form 'storefront_password', class: 'space-y-3' %}
      {% if form.errors %}
        <div class="text-xs text-red-600 bg-red-50 p-2 border border-red-200">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      <div>
        <input type="password" name="password" id="Password" class="w-full px-4 py-3 border border-[#E5DFD5] text-xs focus:outline-none focus:border-[#4A4C3A]" placeholder="Enter password">
      </div>
      <button type="submit" class="w-full py-3 bg-[#4A4C3A] text-ivory text-xs font-medium uppercase tracking-widest hover:bg-[#2E3025] transition-colors">
        Enter Store
      </button>
    {% endform %}
  </div>

  <p class="text-xs text-[#8C7A6B]">
    Store owner? <a href="/admin" class="underline hover:text-[#1A1A1A]">Log in to Shopify Admin</a>
  </p>
</div>
